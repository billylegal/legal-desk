#!/bin/bash
# Legal Desk — one command for the whole dock.
# legal-desk [start|menu|classic|mac|rubik|theme|reset|small|medium|large|restart|status|radio|radio-bar|uninstall|version]
B="/usr/lib/legal-desk"
SH="/usr/share/legal-desk"
VERSION="2.0.0"

# First run: give the classic dock its default look (never overwrites your own style.css).
ensure_config() {
  local c="$HOME/.config/nwg-dock-hyprland"
  mkdir -p "$c" "$HOME/.cache"
  # Renamed from Legal Dock: carry the old data folder (notes, calendar, cities) over.
  [ -d "$HOME/.local/share/legal-dock" ] && [ ! -e "$HOME/.local/share/legal-desk" ] && mv "$HOME/.local/share/legal-dock" "$HOME/.local/share/legal-desk"
  [ -e "$c/style.css" ] || cp "$SH/style.css" "$c/style.css"
}

# First run: a fresh system has no pinned apps, so the dock would show nothing but the launcher. Pin the usual apps that are installed.
seed_pins() {
  local f="$HOME/.cache/nwg-dock-pinned" id d
  [ -s "$f" ] && return
  for id in org.gnome.Nautilus org.kde.dolphin thunar nemo pcmanfm foot kitty Alacritty com.mitchellh.ghostty org.wezfurlong.wezterm \
            firefox chromium google-chrome brave-browser zen-browser spotify discord org.telegram.desktop steam code obsidian vlc mpv; do
    for d in /usr/share/applications "$HOME/.local/share/applications" /var/lib/flatpak/exports/share/applications; do
      [ -e "$d/$id.desktop" ] && { echo "$id" >> "$f"; break; }
    done
  done
  return 0
}

start_all() {
  ensure_config
  seed_pins
  # Each job is fully detached (output closed) so callers - terminals, scripts, ssh - never hang waiting on the dock.
  { pgrep -f "quickshell -n -p $SH/docklock" >/dev/null || setsid quickshell -n -p "$SH/docklock"; } >/dev/null 2>&1 </dev/null &
  { pgrep -f "dock-keepalive" >/dev/null || setsid "$B/dock-keepalive"; } >/dev/null 2>&1 </dev/null &
  { pgrep -f "dock-lock-guard" >/dev/null || setsid "$B/dock-lock-guard"; } >/dev/null 2>&1 </dev/null &
  "$B/macdock-start" >/dev/null 2>&1 </dev/null &
  "$B/legal-zones" start >/dev/null 2>&1 </dev/null &
}

case "${1:-menu}" in
  start) start_all ;;
  menu) start_all; sleep 0.3; quickshell -p "$SH/docklock" ipc call dockmenu toggle ;;
  classic) "$B/macdock-toggle" off ;;
  mac) "$B/macdock-toggle" on ;;
  rubik) "$B/macdock-toggle" rubik ;;
  theme)  # Nebula special edition: install the desktop theme and apply it (plus the matching dock skin)
    src=/usr/share/legal-desk/themes/nebula; [ -d "$src" ] || src="$(dirname "$(readlink -f "$0")")/share/themes/nebula"
    mkdir -p "$HOME/.config/omarchy/themes" && rm -rf "$HOME/.config/omarchy/themes/nebula" && cp -r "$src" "$HOME/.config/omarchy/themes/nebula" || exit 1
    omarchy-theme-set nebula 2>/dev/null || echo "Theme copied to ~/.config/omarchy/themes/nebula - pick Nebula in the Omarchy theme menu."
    for s in classic mac rubik; do echo 0 > "$HOME/.cache/dock-skin-$s"; done; "$B/macdock-skin" apply >/dev/null 2>&1 ;;
  radio) shift; "$B/legal-radio" "$@" ;;
  radio-info) "$B/legal-radio-info" ;;
  radio-bar) "$B/legal-radio-bar" "${2:-status}" ;;
  zones) shift; "$B/legal-zones" "$@" ;;
  reset) "$B/dock-reset" ;;
  pointer) "$B/dock-pointer" "${2:-show}" ;;
  skin) "$B/macdock-skin" "${2:-show}" ;;
  small|medium|large) "$B/dock-size-set" "$1" ;;
  restart)
    pkill -x nwg-dock-hyprla
    for d in docklock macdock; do pkill -f "p $SH/$d\$"; done
    sleep 1; start_all ;;
  status) "$B/macdock-toggle" status; echo "size: $(cat "$HOME/.cache/dock-size" 2>/dev/null || echo medium)" ;;
  uninstall)
    # Hand the dock back to the classic nwg-dock: stop every Legal Desk process, forget its state, start the stock dock.
    for p in "docklock" "macdock"; do pkill -f "p $SH/$p\$"; done
    pkill -f "$B/dock-keepalive"; pkill -f "$B/dock-lock-guard"; pkill -x nwg-dock-hyprla
    rm -f "$HOME/.cache/dock-mac" "$HOME/.cache/dock-locked" "$HOME/.cache/dock-hidden" "$HOME/.cache/dock-full"
    sleep 1; { setsid nwg-dock-hyprland -r -x -i 56; } >/dev/null 2>&1 </dev/null &
    echo "Legal Desk stopped; the classic dock is back. Remove the package with: sudo pacman -R legal-desk" ;;
  version|--version|-v) echo "legal-desk $VERSION" ;;
  *) echo "usage: legal-desk [start|menu|classic|mac|rubik|theme|reset|small|medium|large|restart|status|radio|radio-bar|uninstall|version]"; exit 1 ;;
esac
