#!/bin/bash
# dock-wallpaper next|prev|name : cycle through ALL wallpapers on this system (Omarchy's stock themes, your own themes,
# per-theme user backgrounds, ~/Pictures/Wallpapers). Used by the Legal Desk menu. Only the wallpaper changes, not the theme.
CUR="$HOME/.local/state/omarchy/current"
command -v omarchy-theme-bg-set >/dev/null || { echo "0/0 none"; exit 0; }   # not on Omarchy: the dock hides the Wallpaper row
# The Omarchy skin only offers wallpapers that match its colours: Omarchy's original theme (Tokyo Night).
style=classic; [ -e "$HOME/.cache/dock-mac" ] && { [ "$(cat "$HOME/.cache/dock-style" 2>/dev/null)" = rubik ] && style=rubik || style=mac; }
case $style in classic) OMA_IDX=14;; mac) OMA_IDX=20;; rubik) OMA_IDX=10;; esac
if [ "$(cat "$HOME/.cache/dock-skin-$style" 2>/dev/null)" = "$OMA_IDX" ]; then
  mapfile -t W < <(find -L /usr/share/omarchy/themes/tokyo-night/backgrounds -maxdepth 1 -type f \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.webp' \) 2>/dev/null | while read -r f; do readlink -f "$f"; done | sort -u)
else
  mapfile -t W < <(
    { find -L /usr/share/omarchy/themes/*/backgrounds "$HOME"/.config/omarchy/themes/*/backgrounds "$HOME"/.config/omarchy/backgrounds \
        "$HOME/Pictures/Wallpapers" -maxdepth 2 -type f \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.webp' \) 2>/dev/null
    } | while read -r f; do echo "$(readlink -f "$f")"; done | sort -u)
fi
N=${#W[@]}
idx() {  # exact path first; the current theme keeps a copy of its backgrounds, so fall back to same name + size
  local now sz; now=$(readlink -f "$CUR/background" 2>/dev/null); i=-1
  for k in "${!W[@]}"; do [ "${W[$k]}" = "$now" ] && { i=$k; return; }; done
  sz=$(stat -c %s "$now" 2>/dev/null)
  for k in "${!W[@]}"; do [ "$(basename "${W[$k]}")" = "$(basename "$now")" ] && [ "$(stat -c %s "${W[$k]}")" = "$sz" ] && { i=$k; return; }; done
}
idx
case "${1:-name}" in
  next) [ $N -gt 0 ] && { i=$(( (i + 1) % N )); omarchy-theme-bg-set "${W[$i]}" >/dev/null 2>&1; } ;;
  prev) [ $N -gt 0 ] && { [ $i -lt 0 ] && i=0; i=$(( (i - 1 + N) % N )); omarchy-theme-bg-set "${W[$i]}" >/dev/null 2>&1; } ;;
esac
idx
b=$(basename -- "$(readlink -f "$CUR/background" 2>/dev/null)"); b=${b%.*}; b=$(echo "$b" | sed 's/^[0-9]*-//; s/-/ /g')
echo "$((i + 1))/$N $b"
