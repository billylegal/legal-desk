#!/bin/bash
# legal-radio window|toggle|play|live|stop|volume N|mute|station next|ID : 1UP Radio from the dock (our own player, up1-radio: mpv + yt-dlp).
#   window  open the Nebula radio window (small); press again for medium, large, then it closes. Opening it also starts the radio when it is not playing; closing never stops the music.
#           Drag the window anywhere; the spot is remembered (~/.cache/dock-radio-pos).
R="$(dirname "$(readlink -f "$0")")/up1-radio"
[ -x "$R" ] || { notify-send "1UP Radio" "The radio player (up1-radio) is missing."; exit 1; }
# every request is noted (when, what, by which program) so a start nobody asked for can be traced: ~/.cache/legal-radio-calls.log
[ "$1" = status ] || echo "$(date +%F\ %T) $* <- $(ps -o args= -p $PPID | cut -c1-90)" >> "$HOME/.cache/legal-radio-calls.log" 2>/dev/null
case "${1:-window}" in
  window)
    # Each press of the dock button: open small -> medium -> large -> close. (The player stays on; only the window goes.)
    S="$HOME/.cache/dock-radio-size"
    if pgrep -f '^quickshell.*legalradio' >/dev/null; then
      n=$(cat "$S" 2>/dev/null); [[ $n =~ ^[0-9]$ ]] || n=0
      if [ "$n" -ge 2 ]; then pkill -f '^quickshell.*legalradio'; else echo $((n + 1)) > "$S"; fi
      exit 0
    fi
    mkdir -p "$HOME/.cache"; echo 0 > "$S"
    "$R" status | grep -q '"playing": true' || "$R" play >/dev/null 2>&1 &
    [ -n "$WAYLAND_DISPLAY$DISPLAY" ] || export QUICKSHELL_QT_PLATFORM=offscreen   # only truly headless sessions render offscreen; real sessions show the window
    setsid -f quickshell -n -p "/usr/share/legal-desk/legalradio" >/dev/null 2>&1 </dev/null; exit 0 ;;
  save) exec "$(dirname "$(readlink -f "$0")")/legal-radio-save" "${2:-toggle}" ;;
  station)   # station next | station ID | station list : switch between 1UP Radio, Culture Shock, The Vault and The Movement (the logo in the player windows calls "station next")
    cur=$("$R" status 2>/dev/null | python3 -c 'import json,sys; print((json.load(sys.stdin).get("station") or {}).get("id","1up"))' 2>/dev/null); cur=${cur:-1up}
    ids=$("$R" stations 2>/dev/null | python3 -c 'import json,sys; print(" ".join(s["id"] for s in json.load(sys.stdin)))' 2>/dev/null); [ -n "$ids" ] || ids="1up"
    case "${2:-next}" in
      list) echo "$ids"; exit 0 ;;
      next) tgt=$(python3 - "$cur" $ids <<'PY'
import sys
cur, ids = sys.argv[1], sys.argv[2:]
print(ids[(ids.index(cur) + 1) % len(ids)] if cur in ids else ids[0])
PY
) ;;
      *) tgt="$2" ;;
    esac
    [ "${3:-}" = "--dry" ] && { echo "$cur -> $tgt"; exit 0; }
    exec "$R" play --station "$tgt" ;;
  live) exec "$R" play --live ;;
  *) exec "$R" "$@" ;;
esac
