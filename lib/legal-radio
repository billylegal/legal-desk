#!/bin/bash
# legal-radio toggle|play|live|stop : 1UP Radio from the dock (uses SnapDock's player, sd-radio).
R=/usr/lib/snapdock/bin/sd-radio; command -v sd-radio >/dev/null && R=sd-radio
[ -x "$R" ] || command -v "$R" >/dev/null || { notify-send "1UP Radio" "The radio player (SnapDock's sd-radio) is not installed."; exit 1; }
case "${1:-toggle}" in
  live) exec "$R" play --live ;;
  *) exec "$R" "${1:-toggle}" ;;
esac
