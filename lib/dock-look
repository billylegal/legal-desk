#!/bin/bash
# dock-look transparent|solid|status : the dock's look.
#   transparent = icons float, no plate;  solid = one plate behind all the icons.  (The old Block look is gone: block now means solid.)
# (The full-width bar is a separate switch: dock-full-toggle / "Full-width dock" in the menu.)
H="$HOME/.cache"; C="$HOME/.config/nwg-dock-hyprland/style.css"; B="$(dirname "$(readlink -f "$0")")"
is_t() { [ -e "$H/dock-transparent" ] || grep -q "background: transparent" "$C" 2>/dev/null; }
case "$1" in
  transparent) wt=1; wb=0 ;;
  solid)       wt=0; wb=0 ;;
  block)       wt=0; wb=0 ;;   # removed look: falls back to solid
  *) if is_t; then echo transparent; else echo solid; fi; exit 0 ;;
esac
rm -f "$H/dock-block"   # the Block flag is retired
cur=0; is_t && cur=1; [ "$cur" != "$wt" ] && "$B/dock-transparent-toggle"
exit 0
