#!/bin/bash
# macdock-skin next|prev|N|show|apply : choose the skin of the current dock style.
#   classic: 13 themes (colours, Windows 95/98/11, Polybar, Tint2; written to the nwg-dock style.css)   mac: 19 plates/icon looks   rubik: 9 tile palettes
# Each style remembers its own skin in ~/.cache/dock-skin-<style>.
H="$HOME/.cache"; C="$HOME/.config/nwg-dock-hyprland/style.css"
style=classic
if [ -e "$H/dock-mac" ]; then [ "$(cat "$H/dock-style" 2>/dev/null)" = rubik ] && style=rubik || style=mac; fi
case $style in classic) N=15; D=13;; mac) N=21; D=19;; rubik) N=11; D=9;; esac   # D = Nebula, the standard skin
F="$H/dock-skin-$style"
get() { local v; v=$(cat "$1" 2>/dev/null); [[ $v =~ ^[0-9]+$ ]] && [ "$v" -lt "$2" ] && echo "$v" || echo "${3:-$D}"; }   # no choice yet = Nebula

# The "Omarchy" skin (last in every style) uses Omarchy's original colours for the menus.
OMA="$HOME/.local/state/omarchy/current/theme/colors.toml"
omac() { local v; v=$(sed -n "s/^$1[[:space:]]*=[[:space:]]*\"\(#[0-9a-fA-F]\{6\}\)\".*/\1/p" "$OMA" 2>/dev/null | head -1); echo "${v:-$2}"; }
oma_row() { echo "#1a1b26|#7aa2f7|#c0caf5|#292e42"; }   # Omarchy's original colours (Tokyo Night, the theme it installs with)

# Menu colours follow the skin: bg|border/accent|text|selected. Written to ~/.cache/dock-menu-colors for the dock menus.
MAC=("#111c18|#C1C497|#C1C497|#2a3a30" "#1b1f2a|#cfd8ff|#ffffff|#333a52" "#0b1230|#7a8cff|#cfd6ff|#1c2a66" "#06080c|#39ff14|#b8ffa8|#123a0c" "#e4e5ea|#6b7080|#20232a|#c4c8d2" "#0f3d7a|#8fd0ff|#eaf6ff|#1f5fb0" "#4a0c2c|#ff9a3d|#ffe3c8|#7a1a48" "#0a0a0a|#ffffff|#eeeeee|#2a2a2a" "#f4f1e8|#8a8570|#2b2b2b|#dcd8c8" "#020a02|#33ff33|#33ff33|#0c3a0c" "#0e0700|#ffb000|#ffb000|#3a2600" "#0a3a80|#ffffff|#d6ecff|#1558b0" "#0b1020|#4cc9f0|#eaf0ff|#1c2a50" "#15181f|#d8d8d8|#f2f2f2|#2c313c" "#c0c0c0|#000080|#000000|#a0a0a0" "#d8d8d8|#000080|#000000|#b8b8b8" "#202020|#60cdff|#ffffff|#333333" "#1d2021|#fabd2f|#ebdbb2|#3c3836" "#202020|#aaaaaa|#ffffff|#444444" "#0B0818|#8B5CF6|#E6E1FA|#2A1B52" "OMA")
RUBIK=("#0d0d0d|#ffd500|#f4f4f4|#2a2a2a" "#f4eef7|#b58acb|#3a2a45|#e0d0ea" "#000000|#ffffff|#eeeeee|#2a2a2a" "#06080c|#39ff14|#b8ffa8|#123a0c" "#3a0a2a|#ffd9b0|#ffe9d0|#6a1a4a" "#04202e|#0096c7|#caf0f8|#0a4a66" "#2b0a3d|#ff4d9d|#ffe0f0|#5a1a6a" "#0a1f0a|#52b788|#d8f3dc|#1b4332" "#0d0d0d|#ffd500|#f4f4f4|#2a2a2a" "#0B0818|#8B5CF6|#E6E1FA|#2A1B52" "OMA")
CLASSIC=(0 2 1 7 3 4 5 6 8 9 10 11 12 19 20)   # classic skin -> the Mac palette of the same name
write_palette() {
  local i row; i=$(get "$F" $N)
  case $style in mac) row=${MAC[$i]};; rubik) row=${RUBIK[$i]};; *) row=${MAC[${CLASSIC[$i]}]};; esac
  [ "$row" = OMA ] && row=$(oma_row)
  IFS='|' read -r b a t sel <<< "$row"
  printf 'bg=%s\nacc=%s\ntxt=%s\nsel=%s\n' "$b" "$a" "$t" "$sel" > "$H/dock-menu-colors.tmp" && mv "$H/dock-menu-colors.tmp" "$H/dock-menu-colors"
  write_drawer "$b" "$a" "$t" "$sel"
}

# The app drawer ("All apps") wears the skin's colours too. nwg-drawer reads its stylesheet at start, so restart it when the colours change.
write_drawer() {
  local D="$HOME/.config/nwg-drawer" new
  mkdir -p "$D"
  new="/* Legal Dock: generated from the dock skin (macdock-skin) - edit freely, it is rewritten when the skin changes. */
window { background-color: $1; color: $3; border: 2px solid $2; border-radius: 16px }
entry { background-color: $4; color: $3; border: 1px solid $2; border-radius: 10px; padding: 6px 10px; caret-color: $2 }
button, image { background: none; border: none; color: $3 }
button { border-radius: 10px; padding: 4px }
button:hover, button:focus { background-color: $4; box-shadow: none }
button:active { background-color: $2; color: $1 }
label { color: $3 }
#category-button { margin: 0 10px 0 10px; border-radius: 10px }
#pinned-box { padding-bottom: 5px; border-bottom: 1px dotted $2 }
#files-box { padding: 5px; border: 1px dotted $2; border-radius: 15px }
#math-label { font-weight: bold; font-size: 16px; color: $2 }"
  if [ "$new" != "$(cat "$D/drawer.css" 2>/dev/null)" ]; then
    printf '%s\n' "$new" > "$D/drawer.css"
    pkill -x nwg-drawer 2>/dev/null; true
  fi
}

# apply_classic : write the nwg-dock stylesheet for the chosen classic skin (keeps solid/transparent as it is).
apply_classic() {
  local i; i=$(get "$H/dock-skin-classic" 15)
  mkdir -p "$(dirname "$C")"
  [ -e "$C" ] && [ ! -e "$C.orig" ] && cp "$C" "$C.orig"
  [ -e "$H/dock-transparent" ] || { [ -e "$C" ] && grep -q "background: transparent" "$C" && touch "$H/dock-transparent"; }
  #        bg                 radius border-colour(s)         text      hover bg                  active-underline   border-width  extra-window-css  extra-hover-css
  case $i in
    0) t=("#111c18" 10 "transparent"            "#C1C497" "rgba(255,255,255,0.15)" "rgba(255,255,255,0.3)" 1 "" "");;
    1) t=("#0a1030" 14 "rgba(122,106,255,0.5)"  "#aab4ff" "rgba(122,140,255,0.28)" "#5b7cff" 1 "" "");;
    2) t=("rgba(255,255,255,0.18)" 16 "rgba(255,255,255,0.65)" "#ffffff" "rgba(255,255,255,0.3)" "#ffffff" 1 "" "");;
    3) t=("#000000" 4  "#ffffff"               "#ffffff" "rgba(255,255,255,0.22)" "#ffffff" 1 "" "");;
    4) t=("#06080c" 8  "#39ff14"               "#39ff14" "rgba(57,255,20,0.2)"    "#39ff14" 1 "" "");;
    5) t=("#d8dadf" 8  "#ffffff"               "#2a2d33" "rgba(0,0,0,0.12)"       "#2a2d33" 1 "" "");;
    6) t=("#a8124a" 16 "#ffd9b0"               "#fff1d6" "rgba(255,217,176,0.28)" "#ffd500" 1 "" "");;
    7) t=("#f6f3ea" 12 "#c9c3b0"               "#2b2b2b" "rgba(0,0,0,0.08)"       "#2b2b2b" 1 "" "");;
    8) t=("#c0c0c0" 0  "#ffffff #404040 #404040 #ffffff" "#000000" "#c0c0c0" "#000080" 2 "" "border: 1px solid; border-color: #ffffff #404040 #404040 #ffffff; border-radius: 0px;");;
    9) t=("linear-gradient(to bottom, #dcdcdc, #bababa)" 0 "#ffffff #404040 #404040 #ffffff" "#000000" "rgba(0,0,0,0.0)" "#0a246a" 2 "" "border: 1px solid; border-color: #ffffff #404040 #404040 #ffffff; border-radius: 0px;");;
    10) t=("rgba(32,32,32,0.92)" 10 "rgba(255,255,255,0.16)" "#ffffff" "rgba(255,255,255,0.12)" "#60cdff" 1 "" "border-radius: 6px;");;
    11) t=("#1d2021" 0 "#fabd2f" "#ebdbb2" "rgba(250,189,47,0.2)" "#fabd2f" 1 "" "border-radius: 0px;");;
    14) IFS='|' read -r ob oa ot os <<< "$(oma_row)"; t=("$ob" 10 "$oa" "$ot" "${os}" "$oa" 1 "" "border-radius: 6px;");;
    12) t=("linear-gradient(to bottom, rgba(80,80,80,0.88), rgba(14,14,14,0.88))" 6 "rgba(255,255,255,0.4)" "#ffffff" "rgba(255,255,255,0.22)" "#ffffff" 1 "" "border-radius: 4px;");;
    13) t=("linear-gradient(to bottom, rgba(42,20,102,0.92), rgba(7,5,15,0.92))" 14 "#8B5CF6" "#E6E1FA" "rgba(139,92,246,0.3)" "#B061FF" 1 "" "border-radius: 6px;");;
  esac
  local bg="${t[0]}"; [ -e "$H/dock-transparent" ] && bg="transparent"
  cat > "$C" <<CSS
window {
  background: $bg;
	border-radius: ${t[1]}px;
	border-style: solid;
	border-width: ${t[6]}px;
	border-color: ${t[2]};
	${t[7]}
}

#box {
  padding: 0px
}

#active {
	border-bottom: solid 1px;
	border-color: ${t[5]}
}

button, image {
	background: none;
	border-style: none;
	box-shadow: none;
	color: ${t[3]}
}

button {
	padding: 4px;
	margin-left: 4px;
	margin-right: 4px;
	color: ${t[3]};
  font-size: 12px
}

button:hover {
	background-color: ${t[4]};
	border-radius: 4px;
	${t[8]}
}

button:focus {
	box-shadow: none
}
CSS
  [ "$style" = classic ] && pkill -x nwg-dock-hyprla    # keepalive brings it back with the new look
}

cur=$(get "$F" $N)
case "$1" in
  next) cur=$(( (cur + 1) % N )) ;;
  prev) cur=$(( (cur + N - 1) % N )) ;;
  [0-9]|[0-9][0-9]) [ "$1" -lt $N ] && cur=$1 ;;
  apply) apply_classic; write_palette; exit 0 ;;
  palette) write_palette; exit 0 ;;
  *) write_palette; echo "$cur"; exit 0 ;;
esac
rm -f "$H/dock-icon-style"   # choosing a skin: the icons follow it again
echo "$cur" > "$F"
write_palette
[ "$style" = classic ] && apply_classic
exit 0
