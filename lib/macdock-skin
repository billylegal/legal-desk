#!/bin/bash
# macdock-skin next|prev|N|show|apply|palette : choose the skin (Legal Desk 2.0: the same 10 skins in Classic, Mac and Rubik).
# The skins live in share/skins.json (read with legal-skins). The choice is remembered in ~/.cache/dock-skin-{classic,mac,rubik} (kept in step) and
# written out as the menu colours (~/.cache/dock-menu-colors), the window title-bar style, the app drawer stylesheet and, on Classic, the nwg-dock CSS.
H="$HOME/.cache"; C="$HOME/.config/nwg-dock-hyprland/style.css"; B="$(dirname "$(readlink -f "$0")")"
style=classic
if [ -e "$H/dock-mac" ]; then [ "$(cat "$H/dock-style" 2>/dev/null)" = rubik ] && style=rubik || style=mac; fi
N=$(python3 -I "$B/legal-skins" count); D=$(python3 -I "$B/legal-skins" default)
F="$H/dock-skin-$style"
get() { local v; v=$(cat "$1" 2>/dev/null); [[ $v =~ ^[0-9]+$ ]] && [ "$v" -lt "$2" ] && echo "$v" || echo "${3:-$D}"; }   # no choice yet = Nebula
vars() { eval "$(python3 -I "$B/legal-skins" vars "$1")"; }

write_palette() {
  local i; i=$(get "$F" $N)
  vars "$i"
  printf 'bg=%s\nacc=%s\ntxt=%s\nsel=%s\n' "$BG" "$ACC" "$TXT" "$SEL" > "$H/dock-menu-colors.tmp" && mv "$H/dock-menu-colors.tmp" "$H/dock-menu-colors"
  write_drawer "$BG" "$ACC" "$TXT" "$SEL" "$NAME" "$DR"
  printf '%s\n' "$BAR" > "$H/dock-bar-style"
  [ "$(cat "$H/dock-menu-colors" "$H/dock-bar-style" 2>/dev/null)" != "$(cat "$H/.bar-colors" 2>/dev/null)" ] && { cat "$H/dock-menu-colors" "$H/dock-bar-style" > "$H/.bar-colors"; ( hyprctl reload >/dev/null 2>&1 & ); }   # window title bars follow the skin
  [ "$(cat "$H/dock-pointer" 2>/dev/null)" = 1 ] || [ "$(cat "$H/dock-pointer" 2>/dev/null)" = 2 ] && ( "$B/dock-pointer" apply >/dev/null 2>&1 & )   # keep the pointer matching the skin
  [ -x "$B/legal-icons" ] && ( "$B/legal-icons" refresh >/dev/null 2>&1 & )                                                                           # the icon sets are drawn in the skin's colours
}

# The app drawer ("All apps") wears the skin's colours too. nwg-drawer reads its stylesheet at start, so restart it when the colours change.
write_drawer() {
  local D="$HOME/.config/nwg-drawer" new rad=${6:-12} th
  # Icon theme: the Yaru colour closest to the skin's accent colour (dark variant on dark skins).
  th=$(python3 - "$1" "$2" <<'PY'
import sys,colorsys
bg,ac=[tuple(int(h.lstrip('#')[i:i+2],16)/255 for i in (0,2,4)) for h in sys.argv[1:3]]
h,l,sat=colorsys.rgb_to_hls(*ac); h*=360
dark=colorsys.rgb_to_hls(*bg)[1]<0.5
if sat<0.2: n=''
elif h<20 or h>=340: n='-red'
elif h<45: n='-wartybrown'
elif h<70: n='-yellow'
elif h<100: n='-olive'
elif h<165: n='-sage'
elif h<195: n='-prussiangreen'
elif h<255: n='-blue'
elif h<300: n='-purple'
else: n='-magenta'
print('Yaru'+n+('-dark' if dark else ''))
PY
)
  printf '%s\n' "$th" > "$HOME/.cache/drawer-icon-theme"; printf '%s\n' "$rad" > "$HOME/.cache/drawer-shape"
  mkdir -p "$D"
  new="/* Legal Desk: generated from the dock skin (macdock-skin) - edit freely, it is rewritten when the skin changes. */
window { background-color: $1; color: $3; border: 2px solid $2; border-radius: 16px }
entry { background-color: $4; color: $3; border: 1px solid $2; border-radius: 10px; padding: 6px 10px; caret-color: $2 }
image { background: none; border: none; color: $3 }
button { border-radius: ${rad}px; padding: 8px; background-color: $4; border: 1px solid $2; margin: 4px }
button:hover, button:focus { background-color: $2; box-shadow: none }
button:hover label, button:focus label { color: $1 }
button:active { background-color: $2; color: $1 }
label { color: $3 }
#category-button { margin: 0 10px 0 10px; border-radius: 10px }
#pinned-box { padding-bottom: 5px; border-bottom: 1px dotted $2 }
#files-box { padding: 5px; border: 1px dotted $2; border-radius: 15px }
#math-label { font-weight: bold; font-size: 16px; color: $2 }"
  if [ "$new" != "$(cat "$D/drawer.css" 2>/dev/null)" ]; then
    printf '%s\n' "$new" > "$D/drawer.css"
    pkill -x nwg-drawer 2>/dev/null; true
  fi
}

# apply_classic : write the nwg-dock stylesheet for the chosen skin (keeps solid/transparent as it is).
apply_classic() {
  local i; i=$(get "$H/dock-skin-classic" $N)
  vars "$i"
  mkdir -p "$(dirname "$C")"
  [ -e "$C" ] && [ ! -e "$C.orig" ] && cp "$C" "$C.orig"
  [ -e "$H/dock-transparent" ] || { [ -e "$C" ] && grep -q "background: transparent" "$C" && touch "$H/dock-transparent"; }
  local bg="$C_BG"; [ -e "$H/dock-transparent" ] && bg="transparent"
  cat > "$C" <<CSS
window {
  background: $bg;
	border-radius: ${C_R}px;
	border-style: solid;
	border-width: ${C_BW}px;
	border-color: $C_BORDER;
	$C_WIN
}

#box {
  padding: 0px
}

#active {
	border-bottom: solid 1px;
	border-color: $C_ACTIVE
}

button, image {
	background: none;
	border-style: none;
	box-shadow: none;
	color: $C_TEXT
}

button {
	padding: 4px;
	margin-left: 4px;
	margin-right: 4px;
	color: $C_TEXT;
  font-size: 12px
}

button:hover {
	background-color: $C_HOVER;
	border-radius: 4px;
	$C_HOV
}

button:focus {
	box-shadow: none
}
CSS
  [ "$style" = classic ] && pkill -x nwg-dock-hyprla    # keepalive brings it back with the new look
}

cur=$(get "$F" $N)
case "$1" in
  next) cur=$(( (cur + 1) % N )) ;;
  prev) cur=$(( (cur + N - 1) % N )) ;;
  [0-9]|[0-9][0-9]) [ "$1" -lt $N ] && cur=$1 ;;
  apply) apply_classic; write_palette; exit 0 ;;
  palette) write_palette; exit 0 ;;
  *) write_palette; echo "$cur"; exit 0 ;;
esac
for s in classic mac rubik; do echo "$cur" > "$H/dock-skin-$s"; done   # one skin list: every style wears the same skin
write_palette
[ "$style" = classic ] && apply_classic
exit 0
