#!/bin/bash
# dock-reset : put everything back to Nebula (the standard): skin (every style), icon look, wallpaper and the Omarchy theme.
H="$HOME/.cache"; B="$(dirname "$(readlink -f "$0")")"
rm -f "$H/dock-icon-style"                                   # icons follow the skin again
echo 19 > "$H/dock-skin-mac"; echo 9 > "$H/dock-skin-rubik"; echo 13 > "$H/dock-skin-classic"
if command -v omarchy-theme-set >/dev/null; then              # desktop theme + its first wallpaper (Omarchy only)
  T="$HOME/.config/omarchy/themes/nebula"
  [ -d "$T" ] || { [ -d /usr/share/legal-dock/themes/nebula ] && mkdir -p "$HOME/.config/omarchy/themes" && cp -r /usr/share/legal-dock/themes/nebula "$T"; }
  [ -d "$T" ] && omarchy-theme-set nebula >/dev/null 2>&1
fi
"$B/macdock-skin" apply >/dev/null 2>&1                       # menu colours + classic dock style for Nebula
