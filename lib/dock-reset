#!/bin/bash
# dock-reset : put everything back to Nebula (the standard): skin (every style), icon look (Purple Chrome), Spark launcher, wallpaper and the Omarchy theme.
H="$HOME/.cache"; B="$(dirname "$(readlink -f "$0")")"
rm -f "$H/dock-pointer-size"
echo 40 > "$H/dock-icon-style"        # every icon in the same purple Legal Desk style (Purple Chrome)
echo 10 > "$H/dock-launcher-icon"      # the Nebula look comes with the Spark launcher
for s in classic mac rubik; do echo 0 > "$H/dock-skin-$s"; done
if command -v omarchy-theme-set >/dev/null; then              # desktop theme + its first wallpaper (Omarchy only)
  T="$HOME/.config/omarchy/themes/nebula"
  [ -d "$T" ] || { [ -d /usr/share/legal-desk/themes/nebula ] && mkdir -p "$HOME/.config/omarchy/themes" && cp -r /usr/share/legal-desk/themes/nebula "$T"; }
  [ -d "$T" ] && omarchy-theme-set nebula >/dev/null 2>&1
fi
[ -x "$B/dock-pointer" ] && "$B/dock-pointer" 0 >/dev/null 2>&1   # pointer back to the original look
"$B/macdock-skin" apply >/dev/null 2>&1                       # menu colours + classic dock style for Nebula
