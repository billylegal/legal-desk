#!/bin/bash
# Dock launcher button: first click opens the app drawer, second click closes it.
# Keeps one resident nwg-drawer in memory so it opens instantly.
OPTS=(-r -closebtn right -c 7 -is 56)
if ! pgrep -x nwg-drawer >/dev/null; then
  nwg-drawer "${OPTS[@]}" >/dev/null 2>&1 &
  exit 0
fi
if hyprctl layers 2>/dev/null | grep -q 'namespace: nwg-drawer'; then
  nwg-drawer -close >/dev/null 2>&1
else
  nwg-drawer -open >/dev/null 2>&1
fi
