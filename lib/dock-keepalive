#!/bin/bash
# Keeps the dock running: restarts nwg-dock-hyprland whenever it exits.
# If ~/.cache/dock-hidden exists the dock runs in auto-hide mode (-d): it only pops up when the mouse hits the bottom.
# If ~/.cache/dock-full exists the dock stretches edge to edge (-f), flush with the bottom of the screen.
exec 9>"${XDG_RUNTIME_DIR:-/tmp}/dock-keepalive.lock"
flock -n 9 || exit 0
while true; do
  # Legal Desk is the default dock: only an explicit "classic" choice keeps the stock nwg-dock.
  [ "$(cat "$HOME/.cache/dock-style" 2>/dev/null)" = classic ] || touch "$HOME/.cache/dock-mac"
  [ -e "$HOME/.cache/dock-mac" ] && pgrep -x nwg-dock-hyprla >/dev/null && pkill -x nwg-dock-hyprla
  if [ ! -e "$HOME/.cache/dock-mac" ] && ! pgrep -x nwg-dock-hyprla >/dev/null; then
    sz=$(cat "$HOME/.cache/dock-size" 2>/dev/null)
    case "$sz" in small) I=32;; large) I=80;; [0-9]*) I=$(( sz * 122 / 100 )); [ $I -lt 28 ] && I=28; [ $I -gt 110 ] && I=110;; *) I=56;; esac   # numeric = the Size slider
    F=""; [ -e "$HOME/.cache/dock-full" ] && F="-f"
    if [ -e "$HOME/.cache/dock-hidden" ]; then
      nwg-dock-hyprland -d -i $I $F -c "$HOME/.local/bin/drawer-toggle" >/dev/null 2>&1 9>&-
    else
      nwg-dock-hyprland -r -x -i $I $F -c "$HOME/.local/bin/drawer-toggle" >/dev/null 2>&1 9>&-
    fi
  fi
  sleep 2
done
