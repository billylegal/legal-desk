#!/bin/bash
# dock-own-toggle __calendar__|__notes__|__tasks__ : keep Legal Dock's own apps in the Mac/Rubik dock (list in ~/.cache/macdock-own), or take them out again.
T="$1"; O="$HOME/.cache/macdock-own"; L="$HOME/.cache/macdock-layout"
case "$T" in __calendar__|__notes__|__tasks__) ;; *) exit 1;; esac
touch "$O"
if grep -qxF -- "$T" "$O"; then
  grep -vxF -- "$T" "$O" > "$O.tmp"; mv "$O.tmp" "$O"
  [ -s "$L" ] && { grep -vxF -- "$T" "$L" > "$L.tmp"; mv "$L.tmp" "$L"; }
else
  echo "$T" >> "$O"
fi
