#!/bin/bash
# macdock-toggle on|off|status — switch between the magnifying macOS-style dock and the classic nwg-dock.
F="$HOME/.cache/dock-mac"
start_mac() { pgrep -f "quickshell -n -p /usr/share/legal-dock/macdock" >/dev/null || setsid quickshell -n -p "/usr/share/legal-dock/macdock" >/dev/null 2>&1 & }
stop_mac() { for p in $(pgrep -f "quickshell -n -p /usr/share/legal-dock/macdock"); do kill "$p"; done; }
case "$1" in
  on)  touch "$F"; pkill -x nwg-dock-hyprla; start_mac ;;   # keepalive no longer restarts nwg-dock while the flag exists
  off) rm -f "$F"; stop_mac ;;                              # keepalive brings nwg-dock back within ~2s
  status) [ -e "$F" ] && echo "macdock (magnifying)" || echo "classic nwg-dock" ;;
  *) echo "usage: macdock-toggle on|off|status"; exit 1 ;;
esac
