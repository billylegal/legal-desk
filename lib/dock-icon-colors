#!/bin/bash
# dock-icon-colors shuffle|off|status : random icon colours for the Mac/Rubik dock.
# shuffle = every app icon gets a coloured tile in a random colour from the active skin's palette (a new random roll each time).
# off     = back to the skin's own look. The choice is remembered in ~/.cache/dock-icon-colors.
F="$HOME/.cache/dock-icon-colors"
case "${1:-status}" in
  shuffle) mkdir -p "$HOME/.cache"; echo "$(( (RANDOM << 15) | RANDOM ))" > "$F" ;;
  off) rm -f "$F" ;;
  *) [ -s "$F" ] && echo "random ($(cat "$F"))" || echo off ;;
esac
