#!/bin/bash
# dock-pointer next|prev|N|show|apply : the mouse pointer's look - 0 Original, 1 Solid, 2 Outlined (solid and outlined wear the skin's colour).
# Builds a tiny cursor theme (~/.local/share/icons/legal-pointer, inherits your normal theme for hands, text, resize ...) and applies it live.
# Remembered in ~/.cache/dock-pointer. Re-applied whenever the skin changes so the pointer keeps matching it.
H="$HOME/.cache"; F="$H/dock-pointer"; T="$HOME/.local/share/icons/legal-pointer"; NAMES=(Original Solid Outlined); N=3
cur=$(cat "$F" 2>/dev/null); [[ $cur =~ ^[0-9]+$ ]] && [ "$cur" -lt $N ] || cur=0
case "$1" in
  next) cur=$(( (cur + 1) % N )); echo "$cur" > "$F" ;;
  prev) cur=$(( (cur + N - 1) % N )); echo "$cur" > "$F" ;;
  [0-9]) [ "$1" -lt $N ] && { cur=$1; echo "$cur" > "$F"; } ;;
  show) echo "$cur ${NAMES[$cur]}"; exit 0 ;;
esac
SIZE=${XCURSOR_SIZE:-24}
if [ "$cur" = 0 ]; then
  rm -rf "$T"; hyprctl setcursor default "$SIZE" >/dev/null 2>&1; echo "$cur ${NAMES[$cur]}"; exit 0
fi
acc=$(sed -n 's/^acc=//p' "$H/dock-menu-colors" 2>/dev/null | head -1); acc=${acc:-#8B5CF6}
bg=$(sed -n 's/^bg=//p' "$H/dock-menu-colors" 2>/dev/null | head -1); bg=${bg:-#0B0818}
inh=$(sed -n 's/^Inherits=//p' /usr/share/icons/default/index.theme 2>/dev/null | head -1); inh=${inh:-Adwaita}
mkdir -p "$T/cursors"
printf '[Icon Theme]\nName=Legal Pointer\nInherits=%s\n' "$inh" > "$T/index.theme"
python3 -I - "$cur" "$acc" "$bg" "$T/cursors" <<'PY'
import struct, subprocess, sys, os
mode, acc, bg, out = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4]
P = "M2,2 L2,19 L6.4,15 L9.4,21.4 L12.2,20.2 L9.3,13.9 L15.2,13.9 Z"
def svg(size):
    if mode == "1":   # solid: filled in the skin colour, thin dark edge, light halo
        body = '<path d="%s" fill="%s" stroke="#000000" stroke-opacity=".85" stroke-width="1.3" stroke-linejoin="round"/>' % (P, acc)
    else:             # outlined: hollow, skin-coloured outline over a dark edge
        body = ('<path d="%s" fill="%s" fill-opacity=".35" stroke="#000000" stroke-opacity=".8" stroke-width="3.6" stroke-linejoin="round"/>'
                '<path d="%s" fill="none" stroke="%s" stroke-width="1.8" stroke-linejoin="round"/>') % (P, bg, P, acc)
    return '<svg xmlns="http://www.w3.org/2000/svg" width="%d" height="%d" viewBox="0 0 24 24">%s</svg>' % (size, size, body)
def png_argb(size):
    from_png = subprocess.run(["magick", "svg:-", "-depth", "8", "rgba:-"], input=svg(size * 4).encode(), capture_output=True, check=True) if False else None
    p = subprocess.run(["rsvg-convert", "-w", str(size), "-h", str(size)], input=svg(size).encode(), capture_output=True, check=True).stdout
    raw = subprocess.run(["magick", "png:-", "-depth", "8", "rgba:-"], input=p, capture_output=True, check=True).stdout
    px = bytearray()
    for i in range(0, len(raw), 4):                         # RGBA straight -> ARGB premultiplied, little-endian
        r, g, b, a = raw[i:i + 4]
        r, g, b = r * a // 255, g * a // 255, b * a // 255
        px += struct.pack("<I", (a << 24) | (r << 16) | (g << 8) | b)
    return bytes(px)
sizes = [24, 32, 48, 64, 96]
chunks = []
for s in sizes:
    hot = int(round(2 * s / 24.0))
    data = struct.pack("<IIIIIIIII", 36, 0xfffd0002, s, 1, s, s, hot, hot, 50) + png_argb(s)
    chunks.append((s, data))
hdr = 16 + 12 * len(chunks); pos = hdr; toc = b""; body = b""
for s, d in chunks:
    toc += struct.pack("<III", 0xfffd0002, s, pos + len(body)); body += d
blob = b"Xcur" + struct.pack("<III", 16, 0x10000, len(chunks)) + toc + body
names = ["left_ptr", "default", "arrow", "top_left_arrow", "left_arrow", "x-cursor"]
first = os.path.join(out, names[0]); open(first, "wb").write(blob)
for n in names[1:]:
    p = os.path.join(out, n)
    if os.path.lexists(p): os.remove(p)
    os.symlink("left_ptr", p)
PY
hyprctl setcursor legal-pointer "$SIZE" >/dev/null 2>&1
echo "$cur ${NAMES[$cur]}"
