#!/usr/bin/env python3
# legal-zones-core : the engine of Legal Legal Zones (a FancyZones for Hyprland).
#   legal-zones-core list                      layouts + active one (JSON)
#   legal-zones-core new [NAME]                make a new layout of your own (starts as two columns) and print its name
#   legal-zones-core grid COLSxROWS [NAME]     make a grid layout (5x4 = 20 small windows) and switch to it
#   legal-zones-core use NAME                  switch layout
#   legal-zones-core snap [ADDR] N             put a window (default: the active one) into zone N (0-based)
#   legal-zones-core dir left|right|up|down    move the active window to the neighbouring zone
#   legal-zones-core cycle [-1|1]              next / previous zone
#   legal-zones-core apply                     put the open windows of this desktop into the zones (most recent first)
#   legal-zones-core release [ADDR]            let a window go (back to normal tiling)
#   legal-zones-core drag | dragend            (while dragging a window to an edge: preview + snap on release)
#   legal-zones-core watch                     auto-place new windows into free zones (when "auto" is on in the settings)
# Layouts: ~/.local/share/legal-desk/zones.json - zones are fractions of the screen area that is free of bar and dock.
import sys, os, json, subprocess, socket, time

CFG = os.path.expanduser('~/.local/share/legal-desk/zones.json')
STATE = os.path.expanduser('~/.cache/legal-zones-state')
NOBAR = ('org.telegram.desktop', 'org.gnome.')

def T(cols, rows=None):
    return None

def tpl():
    c = lambda n: [[i / n, 0, 1 / n, 1] for i in range(n)]
    r = lambda n: [[0, i / n, 1, 1 / n] for i in range(n)]
    return [
        {'name': 'Two columns', 'zones': c(2)},
        {'name': 'Three columns', 'zones': c(3)},
        {'name': 'Two rows', 'zones': r(2)},
        {'name': 'Grid', 'zones': [[0, 0, .5, .5], [.5, 0, .5, .5], [0, .5, .5, .5], [.5, .5, .5, .5]]},
        {'name': 'Priority grid', 'zones': [[0, 0, .6, 1], [.6, 0, .4, .5], [.6, .5, .4, .5]]},
        {'name': 'Focus', 'zones': [[.15, .08, .7, .84], [0, 0, .15, 1], [.85, 0, .15, 1]]},
    ]

def load():
    try: d = json.load(open(CFG))
    except Exception: d = {}
    if not d.get('layouts'): d['layouts'] = tpl()
    d.setdefault('active', d['layouts'][0]['name']); d.setdefault('gap', 8); d.setdefault('auto', False)
    return d

def save(d):
    os.makedirs(os.path.dirname(CFG), exist_ok=True)
    json.dump(d, open(CFG + '.tmp', 'w')); os.replace(CFG + '.tmp', CFG)

def hj(*a):
    return json.loads(subprocess.run(['hyprctl', '-j', *a], capture_output=True, text=True).stdout or 'null')

def disp(code):
    subprocess.run(['hyprctl', 'dispatch', code], capture_output=True)

def layout(d):
    for l in d['layouts']:
        if l['name'] == d['active']: return l
    return d['layouts'][0]

def area():
    ms = hj('monitors'); m = [x for x in ms if x.get('focused')][0] if ms else None
    w, h = m['width'] / m['scale'], m['height'] / m['scale']
    rl, rt, rr, rb = m['reserved']
    return m['x'] + rl, m['y'] + rt, w - rl - rr, h - rt - rb, m['activeWorkspace']['id']

def rect(z, gap):
    ax, ay, aw, ah, _ = area()
    x0, y0, x1, y1 = ax + z[0] * aw, ay + z[1] * ah, ax + (z[0] + z[2]) * aw, ay + (z[1] + z[3]) * ah
    g = gap / 2
    return x0 + g, y0 + g, x1 - g, y1 - g

def barh(c):
    return 0 if any(c.startswith(n) for n in NOBAR) else 28

def wins(ws=None):
    out = []
    for c in hj('clients') or []:
        if not c.get('mapped') or c.get('hidden'): continue
        if c['workspace']['id'] < 0: continue
        if ws is not None and c['workspace']['id'] != ws: continue
        if c['class'] in ('', 'nwg-drawer') or c['class'].startswith('quickshell'): continue
        out.append(c)
    return out

def snap(addr, n, d=None):
    d = d or load(); L = layout(d)
    if not (0 <= n < len(L['zones'])): return
    cs = [c for c in (hj('clients') or []) if c['address'] == addr]
    if not cs: return
    c = cs[0]
    x0, y0, x1, y1 = rect(L['zones'][n], d['gap'])
    bh = barh(c['class'])
    w = f'window = "address:{addr}"'
    if not c['floating']: disp(f'hl.dsp.window.float({{ action = "enable", {w} }})')
    disp(f'hl.dsp.window.resize({{ x = {int(x1 - x0)}, y = {int(y1 - y0 - bh)}, exact = true, {w} }})')
    disp(f'hl.dsp.window.move({{ x = {int(x0)}, y = {int(y0 + bh)}, exact = true, {w} }})')
    try: st = json.load(open(STATE))
    except Exception: st = {}
    st[addr] = n; json.dump(st, open(STATE, 'w'))

def zone_of(c, d):
    L = layout(d); cx, cy = c['at'][0] + c['size'][0] / 2, c['at'][1] + c['size'][1] / 2
    best, bd = None, 1e18
    for i, z in enumerate(L['zones']):
        x0, y0, x1, y1 = rect(z, 0)
        dd = 0 if (x0 <= cx <= x1 and y0 <= cy <= y1) else ((cx - (x0 + x1) / 2) ** 2 + (cy - (y0 + y1) / 2) ** 2)
        if dd < bd: best, bd = i, dd
    return best

def active():
    a = hj('activewindow')
    return a if a and a.get('address') else None

def main(a):
    cmd = a[0] if a else 'list'
    d = load()
    if cmd == 'list': print(json.dumps(d))
    elif cmd == 'setdata':   # setdata JSON: replace the whole settings + layouts file (used by the editor)
        nd = json.loads(a[1])
        if nd.get('layouts'): save(nd)
    elif cmd == 'use':
        d['active'] = a[1]; save(d)
    elif cmd == 'snap':
        if len(a) == 3: snap(a[1], int(a[2]), d)
        else:
            w = active()
            if w: snap(w['address'], int(a[1]), d)
    elif cmd == 'new':
        base = a[1] if len(a) > 1 else 'My layout'; n, i = base, 2
        while any(l['name'] == n for l in d['layouts']): n = f'{base} {i}'; i += 1
        d['layouts'].append({'name': n, 'zones': [[0, 0, .5, 1], [.5, 0, .5, 1]]}); d['active'] = n; save(d); print(n)
    elif cmd == 'grid':   # grid COLSxROWS [NAME]: make a layout of that many equal zones (20 small windows = 5x4)
        c, r = [max(1, min(12, int(v))) for v in a[1].lower().split('x')]
        base = a[2] if len(a) > 2 else f'Grid {c}x{r}'; n, i = base, 2
        while any(l['name'] == n for l in d['layouts']): n = f'{base} {i}'; i += 1
        d['layouts'].append({'name': n, 'zones': [[x / c, y / r, 1 / c, 1 / r] for y in range(r) for x in range(c)]}); d['active'] = n; save(d); print(n)
    elif cmd == 'cycle':
        w = active()
        if not w: return
        step = int(a[1]) if len(a) > 1 else 1; n = len(layout(d)['zones'])
        cur = zone_of(w, d) if w['floating'] else -1
        snap(w['address'], (cur + step) % n, d)
    elif cmd == 'dir':
        w = active()
        if not w: return
        L = layout(d); cur = zone_of(w, d); zs = L['zones']
        cx = zs[cur][0] + zs[cur][2] / 2; cy = zs[cur][1] + zs[cur][3] / 2
        vec = {'left': (-1, 0), 'right': (1, 0), 'up': (0, -1), 'down': (0, 1)}[a[1]]
        best, bs = None, 1e9
        for i, z in enumerate(zs):
            if i == cur: continue
            dx, dy = z[0] + z[2] / 2 - cx, z[1] + z[3] / 2 - cy
            along = dx * vec[0] + dy * vec[1]; across = abs(dx * vec[1]) + abs(dy * vec[0])
            if along <= 0.01: continue
            s = along + 2 * across
            if s < bs: best, bs = i, s
        if best is not None: snap(w['address'], best, d)
    elif cmd == 'apply':
        ax, ay, aw, ah, ws = area()
        cs = sorted(wins(ws), key=lambda c: c.get('focusHistoryID', 99))
        for i, c in enumerate(cs[:len(layout(d)['zones'])]): snap(c['address'], i, d)
    elif cmd == 'release':
        addr = a[1] if len(a) > 1 else (active() or {}).get('address')
        if addr: disp(f'hl.dsp.window.float({{ action = "disable", window = "address:{addr}" }})')
    elif cmd == 'watch': watch()
    elif cmd == 'drag': drag()
    elif cmd == 'dragend': open(STOP, 'w').close()

DRAG = os.path.expanduser('~/.cache/legal-zones-drag.json')
STOP = os.path.expanduser('~/.cache/legal-zones-stop')

def hsock(cmd):
    sig = os.environ.get('HYPRLAND_INSTANCE_SIGNATURE', '')
    path = f"{os.environ.get('XDG_RUNTIME_DIR', '/run/user/%d' % os.getuid())}/hypr/{sig}/.socket.sock"
    s = socket.socket(socket.AF_UNIX); s.connect(path); s.sendall(cmd.encode()); buf = b''
    while True:
        b = s.recv(65536)
        if not b: break
        buf += b
    s.close(); return json.loads(buf or 'null')

def draw(show, rects=(), hi=-1):
    json.dump({'show': show, 'rects': list(rects), 'hi': hi}, open(DRAG + '.tmp', 'w')); os.replace(DRAG + '.tmp', DRAG)

def log(msg):
    try: open(os.path.expanduser('~/.cache/legal-zones-drag.log'), 'a').write(time.strftime('%H:%M:%S ') + msg + '\n')
    except OSError: pass

def drag():
    """Runs while a window is being dragged (Super + left button): near a screen edge, show the zones and the one under the pointer."""
    d = load()
    if d.get('drag') is False: log('drag off'); return
    time.sleep(0.15)
    w = hsock('j/activewindow')
    if not w or not w.get('address'): log('no active window'); return
    log(f"drag start {w.get('class')} floating={w.get('floating')} at={w['at']}")
    addr, at0, sz0 = w['address'], w['at'], w['size']
    ms = hsock('j/monitors'); m = [x for x in ms if x.get('focused')][0]
    mx, my, mw, mh = m['x'], m['y'], m['width'] / m['scale'], m['height'] / m['scale']
    L = layout(d); rects = [rect(z, d['gap']) for z in L['zones']]
    rel = [[r[0] - mx, r[1] - my, r[2] - r[0], r[3] - r[1]] for r in rects]
    EDGE = 70; shown, hi, moved, t0 = False, -1, False, time.time(); lastsz, szchg = sz0, 0; lastmv, lastc = time.time(), None; why = 'release'
    while time.time() - t0 < 180 and not os.path.exists(STOP):
        c = hsock('j/cursorpos'); cx, cy = c['x'], c['y']
        w = hsock('j/activewindow')
        if w and w.get('address') == addr:
            if w['size'] != lastsz: szchg += 1; lastsz = w['size']   # a window that keeps changing size is being resized, not moved (one change = tiled -> floating)
            if szchg < 4 and abs(w['at'][0] - at0[0]) + abs(w['at'][1] - at0[1]) > 30: moved = True
        if not moved and time.time() - t0 > 4: log('no move in 4s (click/selection)'); return   # just a click or a text selection
        if lastc != (cx, cy) or (w and w.get('at') != at0 and False): lastmv = time.time()
        lastc = (cx, cy)
        if moved and time.time() - lastmv > 3: why = 'idle (no release seen)'; break   # safety net if the button release never reaches us
        near = moved and (cx - mx < EDGE or cy - my < EDGE or mx + mw - cx < EDGE or my + mh - cy < EDGE)
        best, bd = -1, 1e18
        if near:
            for i, r in enumerate(rects):
                dd = 0 if (r[0] <= cx <= r[2] and r[1] <= cy <= r[3]) else ((cx - (r[0] + r[2]) / 2) ** 2 + (cy - (r[1] + r[3]) / 2) ** 2)
                if dd < bd: best, bd = i, dd
        if (near, best) != (shown, hi):
            shown, hi = near, best; draw(near, rel, best)
        time.sleep(0.03)
    try: os.remove(STOP)
    except OSError: pass
    log(f'drag end: {why} moved={moved} shown={shown} zone={hi}')
    if shown and moved and hi >= 0:
        time.sleep(0.15); snap(addr, hi, d)
    draw(False)

def watch():
    sig = os.environ.get('HYPRLAND_INSTANCE_SIGNATURE', '')
    path = f"{os.environ.get('XDG_RUNTIME_DIR', '/run/user/%d' % os.getuid())}/hypr/{sig}/.socket2.sock"
    s = socket.socket(socket.AF_UNIX); s.connect(path); buf = b''
    while True:
        buf += s.recv(4096)
        while b'\n' in buf:
            line, buf = buf.split(b'\n', 1); line = line.decode('utf-8', 'ignore')
            if not line.startswith('openwindow>>'): continue
            d = load()
            if not d.get('auto'): continue
            addr = '0x' + line.split('>>')[1].split(',')[0]
            time.sleep(0.4)
            cs = [c for c in (hj('clients') or []) if c['address'] == addr]
            if not cs or cs[0]['class'] in ('',) or cs[0]['class'].startswith('quickshell') or cs[0].get('floating') and cs[0]['class'].startswith('legal'): continue
            ax, ay, aw, ah, ws = area()
            if cs[0]['workspace']['id'] != ws: continue
            taken = set()
            for c in wins(ws):
                if c['address'] != addr and c['floating']: taken.add(zone_of(c, d))
            free = [i for i in range(len(layout(d)['zones'])) if i not in taken]
            if free: snap(addr, free[0], d)

if __name__ == '__main__':
    main(sys.argv[1:])
