#!/usr/bin/env python3
# dock-running: classes the dock should light up / list as running (JSON).
# A window belongs to the pinned icon it matches (same class, or same app under another browser prefix, e.g. brave-X vs chrome-X) and never adds an icon.
# An unpinned class gets its own icon only the first time it is ever seen ("brand new app"); once it has been closed it is remembered in ~/.cache/macdock-seen and stays off the dock.
import json, os, re, subprocess
H = os.path.expanduser("~")
def lines(p):
    try: return [l.strip() for l in open(os.path.join(H, p)) if l.strip()]
    except OSError: return []
try: cl = json.loads(subprocess.run(["hyprctl", "clients", "-j"], capture_output=True, text=True).stdout or "[]")
except Exception: cl = []
cur = sorted({c["class"] for c in cl if c["class"] and not c["class"].lower().startswith("nwg-")})
pinned = lines(".cache/nwg-dock-pinned"); lay = {l.lower() for l in lines(".cache/macdock-layout")}
norm = lambda c: re.sub(r"^(chrome|brave|chromium|google-chrome)-", "", c.lower())
sp = os.path.join(H, ".cache/macdock-seen")
try: st = json.load(open(sp))
except Exception: st = None
first = st is None
if first: st = {"seen": sorted(set(pinned) | set(cur)), "live": []}
seen, live = set(st.get("seen", [])), set(st.get("live", []))
out = set()
for c in cur:
    lc = c.lower()
    if any(p.lower() == lc for p in pinned): out.add(c); continue
    alt = [p for p in pinned if norm(p) == norm(c)]
    if alt: out.add(next((p for p in alt if p.lower() in lay), alt[0])); continue
    if c in live or c not in seen: live.add(c); out.add(c)
gone = {c for c in live if c not in cur}
seen |= gone; live -= gone
json.dump({"seen": sorted(seen), "live": sorted(live)}, open(sp, "w"))
print(json.dumps(sorted(out)))
