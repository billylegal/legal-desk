def fill(s, d):
    for k, v in d.items():
        s = s.replace("{" + k + "}", str(v))
    return s


def glyph_in(name, col, scale, now):
    """Glyph centred on the 96 board at the given scale."""
    if name == "launcher":
        scale = min(0.95, scale * 1.4)
    t = (96 - 96 * scale) / 2
    col = dict(col)
    col.setdefault("txt", CURTXT)
    out = col["main"] == "none"
    col.setdefault("strk", col["line"] if out else col["main"])
    col.setdefault("strk2", col["line"] if out else col["hi"])
    col.setdefault("psw", col["sw"] * 1.7 if out else 9)
    return f'<g transform="translate({t:.2f} {t:.2f}) scale({scale})">{fill(G(name, now), col)}</g>'


def svg(inner, defs=""):
    return ('<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 96 96" width="96" height="96">'
            + (f"<defs>{defs}</defs>" if defs else "") + inner + "</svg>")


def grad(i, a, b):
    return f'<linearGradient id="{i}" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="{a}"/><stop offset="1" stop-color="{b}"/></linearGradient>'


CURTXT = "#ffffff"


def render(setname, name, p, now=None):
    global CURTXT
    bg, acc, txt = p["bg"], p["acc"], p["txt"]
    # the colour of words drawn inside an icon (the launcher's LEGAL DESK)
    CURTXT = {"Outline": acc, "Glyph": acc, "Duotone": txt, "Neon": mix(acc, "#ffffff", 0.35), "Flat": on(acc), "Sticker": mix(acc, "#000000", 0.25)}.get(setname, "#ffffff")
    dark = lum(bg) < 0.5
    base = dict(line="none", sw=0, isw=5)
    if setname == "Tile":
        a, b = mix(acc, "#ffffff", 0.22), mix(acc, "#000000", 0.4)
        col = dict(base, main="#ffffff", hi=mix("#ffffff", acc, 0.18), lo=mix(acc, "#000000", 0.15), ink=mix(acc, "#000000", 0.55), inv="#ffffff")
        return svg(f'<rect x="2" y="2" width="92" height="92" rx="21" fill="url(#g)"/>' + glyph_in(name, col, 0.62, now), grad("g", a, b))
    if setname == "Outline":
        col = dict(main="none", hi="none", lo="none", line=acc, sw=5, ink=acc, inv=acc, isw=5)
        return svg(glyph_in(name, col, 0.92, now))
    if setname == "Glyph":
        c = mix(acc, "#ffffff", 0.0)
        col = dict(base, main=c, hi=mix(acc, "#ffffff", 0.5), lo=mix(acc, "#000000", 0.35), ink=on(c), inv=on(mix(acc, "#000000", 0.35)))
        return svg(glyph_in(name, col, 0.92, now))
    if setname == "Duotone":
        pl = mix(bg, "#000000", 0.25) if dark else mix(bg, "#000000", 0.08)
        col = dict(base, main=acc, hi=mix(acc, "#ffffff", 0.55), lo=mix(acc, "#000000", 0.4), ink=on(acc), inv="#ffffff")
        return svg(f'<rect x="2" y="2" width="92" height="92" rx="21" fill="{pl}" stroke="{mix(acc, pl, 0.5)}" stroke-width="2"/>' + glyph_in(name, col, 0.64, now))
    if setname == "Glass":
        col = dict(base, main="#ffffff", hi="#ffffff", lo=mix(acc, "#ffffff", 0.2), ink=mix(acc, "#000000", 0.5), inv="#ffffff")
        hl = '<path d="M6 36 a21 21 0 0 1 21 -30 H69 a21 21 0 0 1 21 30 C70 26 26 26 6 36 Z" fill="#ffffff" opacity="0.3"/>'
        return svg(f'<rect x="2" y="2" width="92" height="92" rx="21" fill="url(#g)" stroke="#ffffff" stroke-opacity="0.6" stroke-width="2"/>' + hl
                   + glyph_in(name, col, 0.6, now), grad("g", mix(acc, "#ffffff", 0.45), mix(acc, "#000000", 0.2)).replace('stop-color="', 'stop-opacity="0.85" stop-color="'))
    if setname == "Neon":
        n = mix(acc, "#ffffff", 0.35)
        pl = mix(bg, "#000000", 0.6)
        inner = f'<rect x="2" y="2" width="92" height="92" rx="21" fill="{pl}" stroke="{n}" stroke-opacity="0.55" stroke-width="2"/>'
        glow = dict(main="none", hi="none", lo="none", line=n, sw=11, ink=n, inv=n, isw=11)
        crisp = dict(main="none", hi="none", lo="none", line=n, sw=4.5, ink=n, inv=n, isw=4.5)
        return svg(inner + f'<g opacity="0.22">{glyph_in(name, glow, 0.6, now)}</g>' + glyph_in(name, crisp, 0.6, now))
    if setname == "Flat":
        col = dict(base, main=on(acc) == "#ffffff" and "#ffffff" or "#14121f", hi=mix(on(acc), acc, 0.35), lo=mix(on(acc), acc, 0.15), ink=acc, inv=acc)
        return svg(f'<rect x="2" y="2" width="92" height="92" rx="7" fill="{acc}"/>' + glyph_in(name, col, 0.66, now))
    if setname == "Sticker":
        paper = "#fbfaf6" if dark else "#ffffff"
        col = dict(base, main=acc, hi=mix(acc, "#ffffff", 0.45), lo=mix(acc, "#000000", 0.3), ink=on(acc), inv="#ffffff")
        return svg(f'<rect x="7" y="9" width="88" height="86" rx="19" fill="#000000" opacity="0.22"/>'
                   f'<rect x="2" y="2" width="88" height="88" rx="19" fill="{paper}" stroke="{mix(paper, "#000000", 0.18)}" stroke-width="2"/>'
                   + f'<g transform="translate(-4 -4)">{glyph_in(name, col, 0.66, now)}</g>')
    if setname == "Cube":
        sc = CUBE[STICKER_OF.get(name, 0) % 6]
        col = dict(base, main="#ffffff", hi="#f0f0f0", lo=mix(sc, "#000000", 0.35), ink=mix(sc, "#000000", 0.5), inv="#ffffff")
        return svg('<rect x="1" y="1" width="94" height="94" rx="20" fill="#0d0d0d"/>'
                   f'<rect x="8" y="8" width="80" height="80" rx="13" fill="{sc}"/>' + glyph_in(name, col, 0.56, now))
    raise ValueError(setname)



