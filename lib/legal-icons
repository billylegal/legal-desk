def restyle(raw, name, art, d):
    """sets 29-31: Regular's art turned to silver / gold / bronze; 32-38: the same app drawn by another icon theme (Calendar keeps today's date)."""
    if raw <= 31 or raw >= 39:
        kind = ("silver", "gold", "bronze")[raw - 29] if raw <= 31 else ("nebula", "chrome")[raw - 39]
        with tempfile.TemporaryDirectory() as t:
            a, b = os.path.join(t, "a.svg"), os.path.join(t, "b.png")
            open(a, "w").write(art)
            try:
                subprocess.run([os.path.join(os.path.dirname(os.path.realpath(__file__)), "legal-metal"), kind, a, b], check=True, capture_output=True)
            except Exception:
                return art
            import base64
            return ('<svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" viewBox="0 0 256 256" width="256" height="256">'
                    '<image width="256" height="256" xlink:href="data:image/png;base64,%s"/></svg>' % base64.b64encode(open(b, "rb").read()).decode())
    key = ("tela", "mactahoe", "colloid", "mcmojave", "qogir", "fluent", "papirus")[raw - 32]
    ctx, names = THEME_OWN.get(name, (None, []))
    for nm in names:
        f = os.path.join(THEME_DIR, key, ctx, nm + ".svg")
        if os.path.isfile(f):
            return open(f).read()
    return art


def refresh(idx=None, now=None):
    if idx is None:
        try:
            idx = int(open(os.path.join(CACHE, "dock-icon-style")).read().strip())
        except (OSError, ValueError):
            idx = 0
    raw = idx
    if idx >= 21:   # 21-28 = Regular's icons with an effect (mono / 3D / dance / spin, done by the dock); 29-31 metal, 32-38 other icon themes: Regular drawn first
        idx = 12
    # dock-icon-style numbers its entries 0..9; anything else = the default set
    setname = SETS[idx] if 0 <= idx < len(SETS) else SETS[0]
    p = palette()
    stamp = "v%d" % int(time.time() * 1000)
    d = os.path.join(OUT, stamp)
    os.makedirs(d, exist_ok=True)
    for n in NAMES:
        art = draw(setname, n, p, now)
        if raw >= 29 and n not in ("launcher", "radio"):
            art = restyle(raw, n, art, d)
        open(os.path.join(d, n + ".svg"), "w").write(art)
    for src in ("/usr/share/legal-desk/radio-1up.svg",):   # 1UP Radio keeps its own logo in every set
        if os.path.exists(src):
            shutil.copy(src, os.path.join(d, "radio.svg"))
    tmp = os.path.join(OUT, "current.tmp")
    open(tmp, "w").write(stamp + "\n")
    os.replace(tmp, os.path.join(OUT, "current"))
    for old in os.listdir(OUT):
        if old.startswith("v") and old != stamp:
            shutil.rmtree(os.path.join(OUT, old), ignore_errors=True)
    return d


def install_hicolor(d):
    t = os.path.join(HOME, ".local", "share", "icons", "hicolor", "scalable", "apps")
    os.makedirs(t, exist_ok=True)
    for n in NAMES:
        shutil.copy(os.path.join(d, n + ".svg"), os.path.join(t, "legal-desk-%s.svg" % n))


def preview(out):
    p = palette()
    cells = []
    with tempfile.TemporaryDirectory() as d:
        shown = ["calendar", "notes", "tasks", "disks", "zones", "clock", "camera", "desk", "apps", "mail", "trash", "folder", "power"]
        rows = []
        for s in SETS[:21]:
            row = []
            for n in shown:
                f = os.path.join(d, f"{s}-{n}.png")
                tmpsvg = os.path.join(d, "x.svg")
                open(tmpsvg, "w").write(draw(s, n, p))
                subprocess.run(["rsvg-convert", "-w", "72", "-h", "72", "-o", f, tmpsvg], check=True)
                row.append(f)
            rows.append(row)
            subprocess.run(["magick"] + row + ["-background", p["bg"], "-gravity", "center", "-extent", "80x80", "+append", os.path.join(d, f"row-{s}.png")]
                           if False else ["magick", "-background", p["bg"]] + ["(", *row, "-background", p["bg"], "+append", ")"] + [os.path.join(d, f"row-{s}.png")], check=True)
        subprocess.run(["magick", "-background", p["bg"]] + [os.path.join(d, f"row-{s}.png") for s in SETS[:21]] + ["-append", out], check=True)


if __name__ == "__main__":
    cmd = sys.argv[1] if len(sys.argv) > 1 else "refresh"
