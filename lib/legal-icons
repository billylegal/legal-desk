def ph_body(weight, name):
    t = open(os.path.join(PHDIR, weight, PH[name] + ".svg")).read()
    return re.sub(r"^.*?<svg[^>]*>|</svg>\s*$", "", t, flags=re.S)


def free(setname, name, p, now=None):
    now = now or datetime.datetime.now()
    bg, acc, txt = p["bg"], p["acc"], p["txt"]
    if setname == "Type":
        if name == "calendar":
            return svg(f'<text x="48" y="32" text-anchor="middle" font-family="Bebas Neue, DejaVu Sans" font-size="22" letter-spacing="4" fill="{acc}">{now.strftime("%a").upper()}</text>'
                       f'<text x="48" y="80" text-anchor="middle" font-family="Bebas Neue, DejaVu Sans" font-size="60" fill="{txt}">{now.day}</text>')
        w = WORD[name]
        size = min(54, 74 / (0.45 * len(w) + 0.05 * len(w)))
        return svg(f'<text x="48" y="{48 + size * 0.36:.1f}" text-anchor="middle" font-family="Bebas Neue, DejaVu Sans" font-size="{size:.1f}" letter-spacing="2" fill="{acc}">{w}</text>'
                   '')
    if setname == "Regular" and name == "disks":   # a different disk for Regular: the macOS external drive
        for _d in (SH, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "share")):
            if os.path.isfile(os.path.join(_d, "regular", "disks.svg")):
                return open(os.path.join(_d, "regular", "disks.svg")).read()
    if setname == "Regular" and APPLE and name in ("tasks", "notes", "disks", "zones", "folder", "folder-download", "trash", "trash-full") and os.path.exists(os.path.join(APPLE, name + ".svg")):
        return apple(name, now)   # macOS-style art for these, like the date below
    if setname == "Regular" and name == "calendar":   # Apple-style date: white page, red weekday band, big day number
        return svg('<rect x="7" y="9" width="84" height="84" rx="18" fill="#000" opacity="0.25"/>'
                   '<clipPath id="cp"><rect x="5" y="5" width="86" height="86" rx="18"/></clipPath>'
                   '<g clip-path="url(#cp)"><rect x="5" y="5" width="86" height="86" fill="#ffffff"/><rect x="5" y="5" width="86" height="27" fill="#ff3b30"/></g>'
                   '<rect x="5" y="5" width="86" height="86" rx="18" fill="none" stroke="#000" stroke-opacity="0.12" stroke-width="1.5"/>'
                   f'<text x="48" y="25" text-anchor="middle" font-family="Helvetica, Arial, Liberation Sans, DejaVu Sans, sans-serif" font-weight="700" font-size="14" letter-spacing="1.5" fill="#ffffff">{now.strftime("%a").upper()}</text>'
                   f'<text x="48" y="77" text-anchor="middle" font-family="Helvetica, Arial, Liberation Sans, DejaVu Sans, sans-serif" font-weight="300" font-size="46" fill="#1c1c1e">{now.day}</text>')
    if setname == "Regular" and name == "notes":   # Regular is mono, but its date and note are coloured like the Colour set
        setname = "Colour"
    wt = WEIGHT[setname]
    body = ph_body(wt, name)
    hue = HUE[name]
    # colours: main glyph, the soft second tone of duotone, ink for the calendar's day number
    main = {"Thin": txt, "Light": acc, "Regular": txt, "Bold": acc, "Fill": acc, "Two-tone": acc, "Shadow": acc, "Gradient": acc, "Colour": hue}[setname]
    soft = mix(main, "#ffffff", 0.45)
    if wt == "duotone":
        body = body.replace('opacity="0.2"', f'fill="{soft}" opacity="0.55"')
    fillc = main
    defs = ""
    if setname == "Gradient":
        defs = f'<linearGradient id="gg" gradientUnits="userSpaceOnUse" x1="40" y1="20" x2="216" y2="236"><stop offset="0" stop-color="{mix(acc, "#ffffff", 0.55)}"/><stop offset="1" stop-color="{mix(acc, "#000000", 0.25)}"/></linearGradient>'
        fillc = "url(#gg)"
    glyph = f'<g fill="{fillc}">{body}</g>'
    inner = glyph
    if setname == "Shadow":
        sh = mix(acc, bg, 0.6)
        inner = "".join(f'<g fill="{sh}" transform="translate({i * 2.6:.1f} {i * 2.6:.1f})">{body}</g>' for i in range(16, 0, -1)) + glyph
    # the calendar's day number sits in the page
    if name == "calendar":
        numc = {"Fill": on(acc), "Shadow": on(acc), "Gradient": on(acc)}.get(setname, main)
        wgt = {"Thin": 300, "Light": 400}.get(setname, 700)
        inner += f'<text x="128" y="186" text-anchor="middle" font-family="DejaVu Sans, sans-serif" font-weight="{wgt}" font-size="92" fill="{numc}">{now.day}</text>'
    k = 0.34 if setname == "Shadow" else 0.4
    t = (96 - 256 * k) / 2 - (3.5 if setname == "Shadow" else 0)
    return svg(f'<g transform="translate({t:.2f} {t:.2f}) scale({k})">{inner}</g>', defs)


def pixelate(svgtext, cells=32):
    """Rasterise at cells x cells and rebuild as crisp square pixels (the Pixel set)."""
    with tempfile.TemporaryDirectory() as d:
        f = os.path.join(d, "a.svg")
        open(f, "w").write(svgtext)
        subprocess.run(["rsvg-convert", "-w", str(cells), "-h", str(cells), "-o", os.path.join(d, "a.png"), f], check=True)
        raw = subprocess.run(["magick", os.path.join(d, "a.png"), "-depth", "8", "txt:-"], capture_output=True, text=True, check=True).stdout
    px = 96 / cells
    rects = []
    for line in raw.splitlines()[1:]:
        m = re.match(r"(\d+),(\d+): \(\s*(\d+),\s*(\d+),\s*(\d+),\s*(\d+)\)", line)
        if not m:
            continue
        x, y, r, g, b, a = map(int, m.groups())
        if a < 110:
            continue
        rects.append(f'<rect x="{x * px:.2f}" y="{y * px:.2f}" width="{px + 0.35:.2f}" height="{px + 0.35:.2f}" fill="{hx((r, g, b))}"/>')
    return svg("".join(rects)).replace("<svg ", '<svg shape-rendering="crispEdges" ')


APPLE = None
for _d in ("/usr/share/legal-desk", os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "share")):
    if os.path.isdir(os.path.join(_d, "apple")):
        APPLE = os.path.join(_d, "apple")
        break


def apple(name, now=None):
    """Apple set: the macOS-style WhiteSur icons as they are (the Calendar shows today's day number)."""
    now = now or datetime.datetime.now()
    t = open(os.path.join(APPLE, name + ".svg")).read()
    if name == "calendar":
        t = t.replace("</svg>", f'<rect x="3.2" y="5.4" width="10.6" height="7.6" fill="#fff"/>'
                      f'<text x="8.47" y="12.35" text-anchor="middle" font-family="Helvetica, Arial, Liberation Sans, sans-serif" font-size="7.4" fill="#f24236">{now.day}</text></svg>')
    return t


def draw(setname, name, p, now=None):
    if setname == "Apple" and APPLE and name not in ("launcher", "radio") and os.path.exists(os.path.join(APPLE, name + ".svg")):
        return apple(name, now)
    if setname == "Apple":   # the Legal Desk launcher and the 1UP Radio logo keep their own look; anything WhiteSur lacks falls back to Tile
        return render("Tile", name, p, now)
    if setname in FREE_SETS:
        if name in ("launcher", "radio"):   # the Legal Desk launcher and the 1UP Radio logo keep their look in every set
            return render("Tile", name, p, now)
        return free(setname, name, p, now)
    if setname == "Pixel":
        inner = render("Flat", name, dict(p), now)
        return pixelate(inner)
    return render(setname, name, p, now)


