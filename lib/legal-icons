#!/usr/bin/env python3
"""legal-icons : draw Legal Desk's own icons (Calendar, Notes, Tasks, Disks, Zones, Clock, Camera, Desk, Apps, Mail, Trash, Folder, Power)
in one of the 10 icon sets, in the colours of the current skin (~/.cache/dock-menu-colors).

  legal-icons refresh        redraw the chosen set (set number in ~/.cache/dock-icon-style) -> ~/.cache/legal-desk/icons/v<time>/ (pointer: icons/current)
  legal-icons names          list the 10 sets
  legal-icons preview OUT    write a PNG contact sheet of all 10 sets (for checking)
  legal-icons install        also copy the set to ~/.local/share/icons/hicolor/scalable/apps/legal-desk-*.svg (launchers, drawer)

Sets: 0 Tile, 1 Outline, 2 Glyph, 3 Duotone, 4 Glass, 5 Neon, 6 Flat, 7 Pixel, 8 Sticker, 9 Cube."""
import datetime, os, re, shutil, subprocess, sys, tempfile, time

HOME = os.path.expanduser("~")
CACHE = os.path.join(HOME, ".cache")
OUT = os.path.join(CACHE, "legal-desk", "icons")
SETS = ["Tile", "Outline", "Glyph", "Duotone", "Glass", "Neon", "Flat", "Pixel", "Sticker", "Cube"]
CUBE = ["#ffd500", "#0b57d0", "#c41e3a", "#00a152", "#ff5a00", "#f4f4f4"]


# ---------- colour helpers ----------
def rgb(h):
    h = h.lstrip("#")
    return tuple(int(h[i:i + 2], 16) for i in (0, 2, 4))


def hx(c):
    return "#%02x%02x%02x" % tuple(max(0, min(255, int(round(v)))) for v in c)


def mix(a, b, t):
    a, b = rgb(a), rgb(b)
    return hx([a[i] + (b[i] - a[i]) * t for i in range(3)])


def lum(h):
    r, g, b = [v / 255 for v in rgb(h)]
    return 0.2126 * r + 0.7152 * g + 0.0722 * b


def on(h):  # readable ink on top of colour h
    return "#14121f" if lum(h) > 0.55 else "#ffffff"


def palette():
    p = {"bg": "#0B0818", "acc": "#8B5CF6", "txt": "#E6E1FA", "sel": "#2A1B52"}
    if os.environ.get("LEGAL_ICONS_PALETTE"):
        p.update(dict(zip(("bg", "acc", "txt", "sel"), os.environ["LEGAL_ICONS_PALETTE"].split(","))))
        return p
    try:
        for line in open(os.path.join(CACHE, "dock-menu-colors")):
            m = re.match(r"\s*(\w+)\s*=\s*(#[0-9a-fA-F]{6})", line)
            if m:
                p[m.group(1)] = m.group(2)
    except OSError:
        pass
    return p


# ---------- glyphs (96 x 96 board). {main} {hi} {lo} fill the shapes, {ink} marks details on main, {inv} on lo, {line}/{sw} outline ----------
def G(name, now=None):
    now = now or datetime.datetime.now()
    wd = now.strftime("%a").upper()
    day = str(now.day)
    S = 'stroke="{line}" stroke-width="{sw}" stroke-linejoin="round" stroke-linecap="round"'
    I = 'stroke="{ink}" stroke-width="{isw}" stroke-linecap="round" stroke-linejoin="round" fill="none"'
    g = {
        "calendar": f'''
<rect x="14" y="16" width="68" height="66" rx="10" fill="{{main}}" {S}/>
<path d="M14 36 V26 a10 10 0 0 1 10 -10 H72 a10 10 0 0 1 10 10 V36 Z" fill="{{lo}}" {S}/>
<path d="M32 8 V22 M64 8 V22" {I}/>
<text x="48" y="31" text-anchor="middle" font-family="DejaVu Sans, sans-serif" font-weight="700" font-size="11" fill="{{inv}}">{wd}</text>
<text x="48" y="70" text-anchor="middle" font-family="DejaVu Sans, sans-serif" font-weight="700" font-size="32" fill="{{ink}}">{day}</text>''',
        "notes": '''
<rect x="16" y="12" width="64" height="74" rx="9" fill="{main}" {S}/>
<path d="M16 32 V21 a9 9 0 0 1 9 -9 H71 a9 9 0 0 1 9 9 V32 Z" fill="{lo}" {S}/>
<text x="48" y="26" text-anchor="middle" font-family="DejaVu Sans, sans-serif" font-weight="700" font-size="10" fill="{inv}">NOTES</text>
<path d="M28 48 H68 M28 60 H68 M28 72 H54" {I}/>'''.replace("{S}", S).replace("{I}", I),
        "tasks": '''
<rect x="16" y="46" width="16" height="34" rx="4" fill="{main}" {S}/>
<rect x="40" y="18" width="16" height="62" rx="4" fill="{hi}" {S}/>
<rect x="64" y="34" width="16" height="46" rx="4" fill="{main}" {S}/>
<path d="M10 86 H86" {I}/>'''.replace("{S}", S).replace("{I}", I),
        "disks": '''
<rect x="8" y="28" width="80" height="44" rx="9" fill="{main}" {S}/>
<path d="M20 56 H52" {I}/>
<circle cx="72" cy="52" r="5" fill="{hi}" {S}/>
<path d="M16 80 H80" stroke="{lo}" stroke-width="5" stroke-linecap="round" fill="none" opacity="0.6"/>'''.replace("{S}", S).replace("{I}", I),
        "zones": '''
<rect x="10" y="10" width="46" height="76" rx="7" fill="{main}" {S}/>
<rect x="62" y="10" width="24" height="35" rx="7" fill="{hi}" {S}/>
<rect x="62" y="51" width="24" height="35" rx="7" fill="{lo}" {S}/>'''.replace("{S}", S),
        "clock": '''
<circle cx="48" cy="48" r="36" fill="{main}" {S}/>
<path d="M48 14 V20 M82 48 H76 M48 82 V76 M14 48 H20" {I}/>
<path d="M48 48 V26 M48 48 L64 58" stroke="{ink}" stroke-width="6" stroke-linecap="round" fill="none"/>
<circle cx="48" cy="48" r="4" fill="{ink}"/>'''.replace("{S}", S).replace("{I}", I),
        "camera": '''
<path d="M32 26 L37 16 H59 L64 26 Z" fill="{lo}" {S}/>
<rect x="9" y="24" width="78" height="54" rx="10" fill="{main}" {S}/>
<circle cx="48" cy="52" r="17" fill="{lo}" {S}/>
<circle cx="48" cy="52" r="8" fill="{hi}" {S}/>
<circle cx="76" cy="36" r="3" fill="{ink}"/>'''.replace("{S}", S),
        "desk": "".join(
            f'<rect x="{12 + (i % 3) * 25}" y="{12 + (i // 3) * 25}" width="21" height="21" rx="5" fill="{{{c}}}" {S}/>'
            for i, c in enumerate(["main", "hi", "lo", "lo", "main", "hi", "hi", "lo", "main"])),
        "apps": "".join(
            f'<circle cx="{22 + (i % 3) * 26}" cy="{22 + (i // 3) * 26}" r="9" fill="{{{c}}}" {S}/>'
            for i, c in enumerate(["main", "hi", "main", "hi", "lo", "hi", "main", "hi", "main"])),
        "mail": '''
<rect x="8" y="22" width="80" height="54" rx="9" fill="{main}" {S}/>
<path d="M14 30 L48 56 L82 30" {I}/>'''.replace("{S}", S).replace("{I}", I),
        "trash": '''
<path d="M38 20 V14 H58 V20" fill="none" stroke="{lo}" stroke-width="6" stroke-linejoin="round"/>
<rect x="18" y="20" width="60" height="9" rx="4" fill="{lo}" {S}/>
<path d="M24 34 H72 L67 84 H29 Z" fill="{main}" {S}/>
<path d="M40 44 V74 M48 44 V74 M56 44 V74" {I}/>'''.replace("{S}", S).replace("{I}", I),
        "trash-full": '''
<path d="M34 20 L40 8 L50 14 L58 6 L64 20" fill="{hi}" {S}/>
<rect x="18" y="20" width="60" height="9" rx="4" fill="{lo}" {S}/>
<path d="M24 34 H72 L67 84 H29 Z" fill="{main}" {S}/>
<path d="M40 44 V74 M48 44 V74 M56 44 V74" {I}/>'''.replace("{S}", S).replace("{I}", I),
        "folder": '''
<path d="M10 28 a8 8 0 0 1 8 -8 H36 L44 30 H78 a8 8 0 0 1 8 8 V70 a8 8 0 0 1 -8 8 H18 a8 8 0 0 1 -8 -8 Z" fill="{main}" {S}/>''',
        "folder-download": '''
<path d="M10 28 a8 8 0 0 1 8 -8 H36 L44 30 H78 a8 8 0 0 1 8 8 V70 a8 8 0 0 1 -8 8 H18 a8 8 0 0 1 -8 -8 Z" fill="{main}" {S}/>
<path d="M48 40 V62 M38 54 L48 64 L58 54" {I}/>'''.replace("{S}", S).replace("{I}", I),
        "radio": '''
<path d="M26 30 L66 12" {I}/>
<rect x="8" y="30" width="80" height="54" rx="10" fill="{main}" {S}/>
<circle cx="32" cy="57" r="14" fill="{lo}" {S}/>
<path d="M56 48 H78 M56 58 H78 M56 68 H70" {I}/>''',
        "power": '''
<path d="M30 26 A32 32 0 1 0 66 26" fill="none" stroke="{strk}" stroke-width="{psw}" stroke-linecap="round"/>
<path d="M48 10 V44" fill="none" stroke="{strk2}" stroke-width="{psw}" stroke-linecap="round"/>''',
    }
    s = g[name]
    # the f-strings above already carry {S}/{I}; fill the leftovers
    return s.replace("{S}", S).replace("{I}", I)


NAMES = ["calendar", "notes", "tasks", "disks", "zones", "clock", "camera", "desk", "apps", "mail", "trash", "trash-full", "folder", "folder-download", "power", "radio"]
STICKER_OF = {"calendar": 1, "notes": 0, "tasks": 3, "disks": 5, "zones": 2, "clock": 1, "camera": 5, "desk": 0, "apps": 4, "mail": 1, "trash": 5, "trash-full": 5,
              "folder": 0, "folder-download": 0, "power": 2, "radio": 4}


def fill(s, d):
    for k, v in d.items():
        s = s.replace("{" + k + "}", str(v))
    return s


def glyph_in(name, col, scale, now):
    """Glyph centred on the 96 board at the given scale."""
    t = (96 - 96 * scale) / 2
    col = dict(col)
    out = col["main"] == "none"
    col.setdefault("strk", col["line"] if out else col["main"])
    col.setdefault("strk2", col["line"] if out else col["hi"])
    col.setdefault("psw", col["sw"] * 1.7 if out else 9)
    return f'<g transform="translate({t:.2f} {t:.2f}) scale({scale})">{fill(G(name, now), col)}</g>'


def svg(inner, defs=""):
    return ('<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 96 96" width="96" height="96">'
            + (f"<defs>{defs}</defs>" if defs else "") + inner + "</svg>")


def grad(i, a, b):
    return f'<linearGradient id="{i}" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="{a}"/><stop offset="1" stop-color="{b}"/></linearGradient>'


def render(setname, name, p, now=None):
    bg, acc, txt = p["bg"], p["acc"], p["txt"]
    dark = lum(bg) < 0.5
    base = dict(line="none", sw=0, isw=5)
    if setname == "Tile":
        a, b = mix(acc, "#ffffff", 0.22), mix(acc, "#000000", 0.4)
        col = dict(base, main="#ffffff", hi=mix("#ffffff", acc, 0.18), lo=mix(acc, "#000000", 0.15), ink=mix(acc, "#000000", 0.55), inv="#ffffff")
        return svg(f'<rect x="2" y="2" width="92" height="92" rx="21" fill="url(#g)"/>' + glyph_in(name, col, 0.62, now), grad("g", a, b))
    if setname == "Outline":
        col = dict(main="none", hi="none", lo="none", line=acc, sw=5, ink=acc, inv=acc, isw=5)
        return svg(glyph_in(name, col, 0.92, now))
    if setname == "Glyph":
        c = mix(acc, "#ffffff", 0.0)
        col = dict(base, main=c, hi=mix(acc, "#ffffff", 0.5), lo=mix(acc, "#000000", 0.35), ink=on(c), inv=on(mix(acc, "#000000", 0.35)))
        return svg(glyph_in(name, col, 0.92, now))
    if setname == "Duotone":
        pl = mix(bg, "#000000", 0.25) if dark else mix(bg, "#000000", 0.08)
        col = dict(base, main=acc, hi=mix(acc, "#ffffff", 0.55), lo=mix(acc, "#000000", 0.4), ink=on(acc), inv="#ffffff")
        return svg(f'<rect x="2" y="2" width="92" height="92" rx="21" fill="{pl}" stroke="{mix(acc, pl, 0.5)}" stroke-width="2"/>' + glyph_in(name, col, 0.64, now))
    if setname == "Glass":
        col = dict(base, main="#ffffff", hi="#ffffff", lo=mix(acc, "#ffffff", 0.2), ink=mix(acc, "#000000", 0.5), inv="#ffffff")
        hl = '<path d="M6 36 a21 21 0 0 1 21 -30 H69 a21 21 0 0 1 21 30 C70 26 26 26 6 36 Z" fill="#ffffff" opacity="0.3"/>'
        return svg(f'<rect x="2" y="2" width="92" height="92" rx="21" fill="url(#g)" stroke="#ffffff" stroke-opacity="0.6" stroke-width="2"/>' + hl
                   + glyph_in(name, col, 0.6, now), grad("g", mix(acc, "#ffffff", 0.45), mix(acc, "#000000", 0.2)).replace('stop-color="', 'stop-opacity="0.85" stop-color="'))
    if setname == "Neon":
        n = mix(acc, "#ffffff", 0.35)
        pl = mix(bg, "#000000", 0.6)
        inner = f'<rect x="2" y="2" width="92" height="92" rx="21" fill="{pl}" stroke="{n}" stroke-opacity="0.55" stroke-width="2"/>'
        glow = dict(main="none", hi="none", lo="none", line=n, sw=11, ink=n, inv=n, isw=11)
        crisp = dict(main="none", hi="none", lo="none", line=n, sw=4.5, ink=n, inv=n, isw=4.5)
        return svg(inner + f'<g opacity="0.22">{glyph_in(name, glow, 0.6, now)}</g>' + glyph_in(name, crisp, 0.6, now))
    if setname == "Flat":
        col = dict(base, main=on(acc) == "#ffffff" and "#ffffff" or "#14121f", hi=mix(on(acc), acc, 0.35), lo=mix(on(acc), acc, 0.15), ink=acc, inv=acc)
        return svg(f'<rect x="2" y="2" width="92" height="92" rx="7" fill="{acc}"/>' + glyph_in(name, col, 0.66, now))
    if setname == "Sticker":
        paper = "#fbfaf6" if dark else "#ffffff"
        col = dict(base, main=acc, hi=mix(acc, "#ffffff", 0.45), lo=mix(acc, "#000000", 0.3), ink=on(acc), inv="#ffffff")
        return svg(f'<rect x="7" y="9" width="88" height="86" rx="19" fill="#000000" opacity="0.22"/>'
                   f'<rect x="2" y="2" width="88" height="88" rx="19" fill="{paper}" stroke="{mix(paper, "#000000", 0.18)}" stroke-width="2"/>'
                   + f'<g transform="translate(-4 -4)">{glyph_in(name, col, 0.66, now)}</g>')
    if setname == "Cube":
        sc = CUBE[STICKER_OF.get(name, 0) % 6]
        col = dict(base, main="#ffffff", hi="#f0f0f0", lo=mix(sc, "#000000", 0.35), ink=mix(sc, "#000000", 0.5), inv="#ffffff")
        return svg('<rect x="1" y="1" width="94" height="94" rx="20" fill="#0d0d0d"/>'
                   f'<rect x="8" y="8" width="80" height="80" rx="13" fill="{sc}"/>' + glyph_in(name, col, 0.56, now))
    raise ValueError(setname)


def pixelate(svgtext, cells=32):
    """Rasterise at cells x cells and rebuild as crisp square pixels (the Pixel set)."""
    with tempfile.TemporaryDirectory() as d:
        f = os.path.join(d, "a.svg")
        open(f, "w").write(svgtext)
        subprocess.run(["rsvg-convert", "-w", str(cells), "-h", str(cells), "-o", os.path.join(d, "a.png"), f], check=True)
        raw = subprocess.run(["magick", os.path.join(d, "a.png"), "-depth", "8", "txt:-"], capture_output=True, text=True, check=True).stdout
    px = 96 / cells
    rects = []
    for line in raw.splitlines()[1:]:
        m = re.match(r"(\d+),(\d+): \(\s*(\d+),\s*(\d+),\s*(\d+),\s*(\d+)\)", line)
        if not m:
            continue
        x, y, r, g, b, a = map(int, m.groups())
        if a < 110:
            continue
        rects.append(f'<rect x="{x * px:.2f}" y="{y * px:.2f}" width="{px + 0.35:.2f}" height="{px + 0.35:.2f}" fill="{hx((r, g, b))}"/>')
    return svg("".join(rects)).replace("<svg ", '<svg shape-rendering="crispEdges" ')


def draw(setname, name, p, now=None):
    if setname == "Pixel":
        inner = render("Flat", name, dict(p), now)
        return pixelate(inner)
    return render(setname, name, p, now)


def refresh(idx=None, now=None):
    if idx is None:
        try:
            idx = int(open(os.path.join(CACHE, "dock-icon-style")).read().strip())
        except (OSError, ValueError):
            idx = 0
    # dock-icon-style numbers its entries 0..9; anything else = the default set
    setname = SETS[idx] if 0 <= idx < len(SETS) else SETS[0]
    p = palette()
    stamp = "v%d" % int(time.time() * 1000)
    d = os.path.join(OUT, stamp)
    os.makedirs(d, exist_ok=True)
    for n in NAMES:
        open(os.path.join(d, n + ".svg"), "w").write(draw(setname, n, p, now))
    for src in ("/usr/lib/snapdock/icons3d/radio-1up.svg",):   # 1UP Radio keeps its own logo in every set
        if os.path.exists(src):
            shutil.copy(src, os.path.join(d, "radio.svg"))
    tmp = os.path.join(OUT, "current.tmp")
    open(tmp, "w").write(stamp + "\n")
    os.replace(tmp, os.path.join(OUT, "current"))
    for old in os.listdir(OUT):
        if old.startswith("v") and old != stamp:
            shutil.rmtree(os.path.join(OUT, old), ignore_errors=True)
    return d


def install_hicolor(d):
    t = os.path.join(HOME, ".local", "share", "icons", "hicolor", "scalable", "apps")
    os.makedirs(t, exist_ok=True)
    for n in NAMES:
        shutil.copy(os.path.join(d, n + ".svg"), os.path.join(t, "legal-desk-%s.svg" % n))


def preview(out):
    p = palette()
    cells = []
    with tempfile.TemporaryDirectory() as d:
        shown = ["calendar", "notes", "tasks", "disks", "zones", "clock", "camera", "desk", "apps", "mail", "trash", "folder", "power"]
        rows = []
        for s in SETS:
            row = []
            for n in shown:
                f = os.path.join(d, f"{s}-{n}.png")
                tmpsvg = os.path.join(d, "x.svg")
                open(tmpsvg, "w").write(draw(s, n, p))
                subprocess.run(["rsvg-convert", "-w", "72", "-h", "72", "-o", f, tmpsvg], check=True)
                row.append(f)
            rows.append(row)
            subprocess.run(["magick"] + row + ["-background", p["bg"], "-gravity", "center", "-extent", "80x80", "+append", os.path.join(d, f"row-{s}.png")]
                           if False else ["magick", "-background", p["bg"]] + ["(", *row, "-background", p["bg"], "+append", ")"] + [os.path.join(d, f"row-{s}.png")], check=True)
        subprocess.run(["magick", "-background", p["bg"]] + [os.path.join(d, f"row-{s}.png") for s in SETS] + ["-append", out], check=True)


if __name__ == "__main__":
    cmd = sys.argv[1] if len(sys.argv) > 1 else "refresh"
    if cmd == "names":
        print("\n".join(SETS))
    elif cmd == "refresh":
        d = refresh()
        if "install" in sys.argv[2:]:
            install_hicolor(d)
    elif cmd == "install":
        install_hicolor(refresh())
    elif cmd == "preview":
        preview(sys.argv[2])
    else:
        print(__doc__)
