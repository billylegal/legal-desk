# ---------- colour helpers ----------
def rgb(h):
    h = h.lstrip("#")
    return tuple(int(h[i:i + 2], 16) for i in (0, 2, 4))


def hx(c):
    return "#%02x%02x%02x" % tuple(max(0, min(255, int(round(v)))) for v in c)


def mix(a, b, t):
    a, b = rgb(a), rgb(b)
    return hx([a[i] + (b[i] - a[i]) * t for i in range(3)])


def lum(h):
    r, g, b = [v / 255 for v in rgb(h)]
    return 0.2126 * r + 0.7152 * g + 0.0722 * b


def on(h):  # readable ink on top of colour h
    return "#14121f" if lum(h) > 0.55 else "#ffffff"


def palette():
    p = {"bg": "#0B0818", "acc": "#8B5CF6", "txt": "#E6E1FA", "sel": "#2A1B52"}
    if os.environ.get("LEGAL_ICONS_PALETTE"):
        p.update(dict(zip(("bg", "acc", "txt", "sel"), os.environ["LEGAL_ICONS_PALETTE"].split(","))))
        return p
    try:
        for line in open(os.path.join(CACHE, "dock-menu-colors")):
            m = re.match(r"\s*(\w+)\s*=\s*(#[0-9a-fA-F]{6})", line)
            if m:
                p[m.group(1)] = m.group(2)
    except OSError:
        pass
    return p


