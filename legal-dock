#!/bin/bash
# Legal Dock — one command for the whole dock.
# legal-dock [start|menu|classic|mac|rubik|theme|small|medium|large|restart|status|uninstall|version]
B="/usr/lib/legal-dock"
SH="/usr/share/legal-dock"
VERSION="1.0.0"

# First run: give the classic dock its default look (never overwrites your own style.css).
ensure_config() {
  local c="$HOME/.config/nwg-dock-hyprland"
  mkdir -p "$c" "$HOME/.cache"
  [ -e "$c/style.css" ] || cp "$SH/style.css" "$c/style.css"
}

start_all() {
  ensure_config
  # Each job is fully detached (output closed) so callers - terminals, scripts, ssh - never hang waiting on the dock.
  { pgrep -f "quickshell -n -p $SH/docklock" >/dev/null || setsid quickshell -n -p "$SH/docklock"; } >/dev/null 2>&1 </dev/null &
  { pgrep -f "dock-keepalive" >/dev/null || setsid "$B/dock-keepalive"; } >/dev/null 2>&1 </dev/null &
  { pgrep -f "dock-lock-guard" >/dev/null || setsid "$B/dock-lock-guard"; } >/dev/null 2>&1 </dev/null &
  "$B/macdock-start" >/dev/null 2>&1 </dev/null &
}

case "${1:-menu}" in
  start) start_all ;;
  menu) start_all; sleep 0.3; quickshell -p "$SH/docklock" ipc call dockmenu toggle ;;
  classic) "$B/macdock-toggle" off ;;
  mac) "$B/macdock-toggle" on ;;
  rubik) "$B/macdock-toggle" rubik ;;
  theme)  # Purple Space special edition: install the desktop theme and apply it (plus the matching dock skin)
    src=/usr/share/legal-dock/themes/purple-space; [ -d "$src" ] || src="$(dirname "$(readlink -f "$0")")/share/themes/purple-space"
    mkdir -p "$HOME/.config/omarchy/themes" && rm -rf "$HOME/.config/omarchy/themes/purple-space" && cp -r "$src" "$HOME/.config/omarchy/themes/purple-space" || exit 1
    omarchy-theme-set purple-space 2>/dev/null || echo "Theme copied to ~/.config/omarchy/themes/purple-space - pick Purple Space in the Omarchy theme menu."
    echo 19 > "$HOME/.cache/dock-skin-mac"; echo 13 > "$HOME/.cache/dock-skin-classic"; echo 9 > "$HOME/.cache/dock-skin-rubik"; "$B/macdock-skin" apply >/dev/null 2>&1 ;;
  skin) "$B/macdock-skin" "${2:-show}" ;;
  small|medium|large) "$B/dock-size-set" "$1" ;;
  restart)
    pkill -x nwg-dock-hyprla
    for d in docklock macdock; do pkill -f "p $SH/$d\$"; done
    sleep 1; start_all ;;
  status) "$B/macdock-toggle" status; echo "size: $(cat "$HOME/.cache/dock-size" 2>/dev/null || echo medium)" ;;
  uninstall)
    # Hand the dock back to the classic nwg-dock: stop every Legal Dock process, forget its state, start the stock dock.
    for p in "docklock" "macdock"; do pkill -f "p $SH/$p\$"; done
    pkill -f "$B/dock-keepalive"; pkill -f "$B/dock-lock-guard"; pkill -x nwg-dock-hyprla
    rm -f "$HOME/.cache/dock-mac" "$HOME/.cache/dock-locked" "$HOME/.cache/dock-hidden" "$HOME/.cache/dock-full"
    sleep 1; { setsid nwg-dock-hyprland -r -x -i 56; } >/dev/null 2>&1 </dev/null &
    echo "Legal Dock stopped; the classic dock is back. Remove the package with: sudo pacman -R legal-dock" ;;
  version|--version|-v) echo "legal-dock $VERSION" ;;
  *) echo "usage: legal-dock [start|menu|classic|mac|rubik|theme|small|medium|large|restart|status|uninstall|version]"; exit 1 ;;
esac
