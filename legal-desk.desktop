[Desktop Entry]
Type=Application
Name=Legal Desk
GenericName=Desktop Suite
Comment=Dock, app launcher, calendar, notes, clock, task manager and disk management
Exec=legal-desk menu
Icon=legal-desk
Terminal=false
Categories=Settings;Utility;
Keywords=dock;taskbar;panel;hyprland;omarchy;
Actions=classic;mac;small;medium;large;restart;

[Desktop Action classic]
Name=Classic style
Exec=legal-desk classic

[Desktop Action mac]
Name=Mac style
Exec=legal-desk mac

[Desktop Action small]
Name=Small
Exec=legal-desk small

[Desktop Action medium]
Name=Medium
Exec=legal-desk medium

[Desktop Action large]
Name=Large
Exec=legal-desk large

[Desktop Action restart]
Name=Restart dock
Exec=legal-desk restart
