[Desktop Entry]
Type=Application
Name=Legal Dock
GenericName=Dock Settings
Comment=Classic or Mac-style dock for Hyprland, with size, lock, hide and transparency controls
Exec=legal-dock menu
Icon=legal-dock
Terminal=false
Categories=Settings;Utility;
Keywords=dock;taskbar;panel;hyprland;omarchy;
Actions=classic;mac;small;medium;large;restart;

[Desktop Action classic]
Name=Classic style
Exec=legal-dock classic

[Desktop Action mac]
Name=Mac style
Exec=legal-dock mac

[Desktop Action small]
Name=Small
Exec=legal-dock small

[Desktop Action medium]
Name=Medium
Exec=legal-dock medium

[Desktop Action large]
Name=Large
Exec=legal-dock large

[Desktop Action restart]
Name=Restart dock
Exec=legal-dock restart
