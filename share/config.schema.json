{
  "$comment": "Legal Dock configuration schema. Every setting is a tiny file in ~/.cache (flag = the file exists). legal-config validates against this file; anything that does not match is repaired (clamped / reset to the default) and the original is kept in ~/.cache/legal-desk/quarantine. Types: boolean = flag file (empty), string/integer/number = one line of text, pair = two integers 'x y'. Patterns are anchored and use only [A-Za-z0-9_.=# -], so no value can ever hold shell syntax.",
  "version": 1,
  "keys": {
    "transparency": { "file": "dock-transparent", "type": "boolean", "default": false, "description": "Transparent dock background (flag file)." },
    "panel_lock":   { "file": "dock-locked",      "type": "boolean", "default": false, "description": "Dock icon order is locked (flag file; the pins are snapshotted in nwg-dock-pinned.locked)." },
    "autohide":     { "file": "dock-hidden",      "type": "boolean", "default": false, "description": "Dock hides itself and pops up at the screen edge (flag file)." },
    "full_width":   { "file": "dock-full",        "type": "boolean", "default": false, "description": "Dock spans the full screen width (flag file)." },
    "mac_dock":     { "file": "dock-mac",         "type": "boolean", "default": true,  "description": "The Legal Dock (Quickshell) is the active dock (flag file)." },
    "style":        { "file": "dock-style",       "type": "string",  "enum": ["classic", "mac", "rubik"], "default": "mac", "description": "Dock style." },
    "size":         { "file": "dock-size",        "type": "string",  "pattern": "^(small|medium|large|[0-9]{2,3})$", "numeric_range": [20, 110], "default": "medium", "description": "Icon size: a word or a number of pixels." },
    "zoom":         { "file": "dock-zoom",        "type": "number",  "minimum": 0, "maximum": 3.2, "default": 0, "description": "Magnification (0 = automatic)." },
    "skin":         { "file": "dock-skin",        "type": "integer", "minimum": 0, "maximum_from": "skins", "default": 0, "description": "Current skin index." },
    "skin_classic": { "file": "dock-skin-classic","type": "integer", "minimum": 0, "maximum_from": "skins", "default": 0 },
    "skin_mac":     { "file": "dock-skin-mac",    "type": "integer", "minimum": 0, "maximum_from": "skins", "default": 0 },
    "skin_rubik":   { "file": "dock-skin-rubik",  "type": "integer", "minimum": 0, "maximum_from": "skins", "default": 0 },
    "icon_style":   { "file": "dock-icon-style",  "type": "integer", "minimum": 0, "maximum": 99, "default": 12, "description": "Icon set number." },
    "launcher_icon":{ "file": "dock-launcher-icon","type": "integer","minimum": 0, "maximum": 40, "default": 10 },
    "bar_style":    { "file": "dock-bar-style",   "type": "string",  "enum": ["apple", "gnome", "nebula", "terminal", "win", "win95"], "default": "nebula", "description": "Window title-bar button style." },
    "clock":        { "file": "dock-clock",       "type": "string",  "enum": ["off", "left", "right"], "default": "right" },
    "clock_format": { "file": "dock-clock-fmt",   "type": "string",  "enum": ["12", "24"], "default": "12" },
    "pointer":      { "file": "dock-pointer",     "type": "integer", "minimum": 0, "maximum": 2, "default": 0 },
    "mouse":        { "file": "dock-mouse",       "type": "string",  "pattern": "^[a-z]{1,12}=[0-9]{1,2}$", "default": "x=1" },
    "radio_icon":   { "file": "dock-radio-icon",  "type": "string",  "enum": ["logo", "meters"], "default": "logo" },
    "radio_size":   { "file": "dock-radio-size",  "type": "integer", "minimum": 0, "maximum": 9, "default": 0 },
    "radio_pos":    { "file": "dock-radio-pos",   "type": "pair",    "minimum": 0, "maximum": 10000, "default": "73 883" },
    "launcher_pos": { "file": "dock-launcher",    "type": "pair",    "minimum": 0, "maximum": 10000, "default": "0 0" }
  },
  "menu_colors": {
    "file": "dock-menu-colors",
    "keys": ["bg", "acc", "txt", "sel"],
    "pattern": "^(bg|acc|txt|sel)=#[0-9a-fA-F]{6}$",
    "description": "Colours shared by every Legal Dock window; regenerated by macdock-skin apply."
  },
  "layouts": {
    "files": ["nwg-dock-pinned", "macdock-layout"],
    "entry_pattern": "^([A-Za-z0-9_.@+:-]{1,128}|__sep__[0-9]{1,12}|__launcher__|__trash__|__radio__|__folder__|__calendar__|__notes__|__tasks__)$",
    "max_entries": 120,
    "min_entries": 1,
    "default": ["chromium", "org.gnome.Nautilus", "foot"],
    "description": "One dock entry per line. A layout that fails validation is replaced by the default and the original is quarantined."
  },
  "limits": { "max_file_bytes": 4096 }
}
